; @primitive layernorm_rows
; @clobbers r1-r28, cfg vlen/len
;
; Y[R,L] int8 = gamma * (x - mean) / sqrt(var) + beta, per row.
;
; --------------------------------------------------------------------------
; The interesting part: **the scalar unit has no shift and no divide.**
; --------------------------------------------------------------------------
; `adds`, `subs`, `muls` and `cmps` are the whole scalar ALU (isa.md §A.4), so
; neither the restoring-sqrt bit walk (which needs `bit >>= 1`) nor a Newton
; iteration (which needs a divide) can be written directly. The way through is
; that **the scratchpad is the shifter**: build the powers of two 1, 2, ... 2^15
; by repeated doubling, `stores` them ascending, then `loads` them back
; descending with a pointer that walks down by 4. Writing the sequence to memory
; and reading it backwards *is* the right shift the ISA does not have.
;
; That one table then drives both scalar loops, which are the same shape:
;
;     q = 0
;     for b in 2^15, 2^14, ... 1:     ; ...read back descending
;         t = q + b
;         if f(t) <= v: q = t          ; f = t*L for divide, t*t for sqrt
;
; giving exactly floor(v/L) and floor(sqrt(v)) in ~12 instructions each.
;
; --------------------------------------------------------------------------
; The vector pipeline, and why it is shaped this way
; --------------------------------------------------------------------------
;     redsum  S    <- row                    S = sum x_i
;     mu = trunc(S / L)                      scalar idiv loop (above)
;     sadd    t32  <- row, -mu               int32: x_i - mu
;     requant c8   <- t32   {1,0}            int8 (clips at +-127)
;     vecdot  SS   <- c8, c8                 SS = sum (x_i - mu)^2, int32
;     R = floor(sqrt(SS))                    scalar isqrt loop (above)
;     sdiv    t32  <- c8, R                  int32 Q15: round(c8 * 2^15 / R)
;     requant t8   <- t32   {m0,n} = RQY     int8 at the output scale
;     vecemul t32  <- t8, gamma              int8 * int8 -> int32
;     requant t8   <- t32   {m0,n} = RQG     int8
;     vecadd  t32  <- t8, beta               int8 + int8 -> int32
;     requant Y    <- t32   {1,0}            int8
;
; `vecdot(c8, c8)` rather than `square` + `redsum` is not a stylistic choice:
; `square` writes int32 and `redsum` reads int8, so the obvious spelling is
; exactly the type error that makes examples/softmax_row.tpu unrunnable.
; `vecdot` does both halves in one op and never leaves int32.
;
; Nothing at run time ever divides by L or by sqrt(L): dividing by L happens once
; in the scalar loop, and the leftover sqrt(L) from normalizing by
; R = sqrt(sum c^2) instead of by sqrt(sum c^2 / L) is a compile-time constant
; folded into RQY's m0 by quant.layernorm_requant.
;
; Precision, stated plainly: c8 is int8, so a row entry more than 127 quantization
; steps from its mean is clipped. That is a property of an int8 LayerNorm, not a
; bug — the integer reference clips identically, so exactness still holds.
;
; @param SRC    DRAM address of X[R,L], int8, row-major
; @param DST    DRAM address of Y[R,L], int8, row-major
; @param GAMMA  DRAM address of gamma[L], int8
; @param BETA   DRAM address of beta[L], int8
; @param R      rows
; @param L      row length (= cfg vlen)
; @param RQY    address of the {m0,n} word applied after the normalize
; @param RQG    address of the {m0,n} word applied after the gamma multiply
; @param RQ1    scratchpad int32 word: holds {m0=1, n=0}, built below
; @param TBL    scratchpad buffer, 64 bytes: the powers-of-two table
; @param C8     scratchpad int8  buffer, L bytes: the centred row
; @param T8     scratchpad int8  buffer, L bytes: shared int8 temporary
; @param T32    scratchpad int32 buffer, L*4 bytes: shared int32 temporary
; @param W0     scratchpad int32 word: the row sum, then the sum of squares
; @param NEGM   scratchpad int32 word: -mean, as a broadcast scalar
; @param RVAL   scratchpad int32 word: R = floor(sqrt(sum c^2))

.equ $BYTES  {{R}} * {{L}}
.equ $NBITS  16                             ; table entries: 2^0 .. 2^15
.equ $TBLTOP {{TBL}} + 4 * ($NBITS - 1)

.reg $src    r1
.reg $dst    r2
.reg $gamma  r3
.reg $beta   r4
.reg $c8     r5
.reg $t8     r6
.reg $t32    r7
.reg $w0     r8
.reg $negm   r9
.reg $rval   r10
.reg $rq1    r11
.reg $rqy    r12
.reg $rqg    r13
.reg $tbl    r14
.reg $rows   r15
.reg $ll     r16                            ; L — also the divisor in the idiv loop
.reg $one    r17
.reg $four   r18
.reg $r      r19
.reg $rowsrc r20
.reg $rowdst r21
.reg $v      r22                            ; scalar work value
.reg $sgn    r23
.reg $q      r24                            ; scalar loop accumulator
.reg $tp     r25                            ; table cursor
.reg $bb     r26                            ; the current power of two
.reg $tt     r27
.reg $uu     r28

    li      $one,  1
    li      $four, 4
    li      $rq1,  {{RQ1}}
    stores  $rq1, $one                      ; {m0 = 1, n = 0}

    ; ---- build the powers-of-two table: 1, 2, 4, ... 2^15 ----
    li      $tbl, {{TBL}}
    li      $v,   1
    li      $tp,  {{TBL}}
    li      $q,   0
    li      $bb,  $NBITS
$tloop:
    cmps    $q, $bb
    bge     $tdone
    stores  $tp, $v
    adds    $v,  $v, $v                     ; the only "shift" the ISA has
    adds    $tp, $tp, $four
    adds    $q,  $q, $one
    jmp     $tloop
$tdone:

    ; ---- stage operands: DRAM -> scratchpad (identical addresses) ----
    li      $src,   {{SRC}}
    li      $dst,   {{DST}}
    li      $gamma, {{GAMMA}}
    li      $beta,  {{BETA}}
    li      $rqy,   {{RQY}}
    li      $rqg,   {{RQG}}
    setcfg  len, 4
    rdmem   $rqy, $rqy
    rdmem   $rqg, $rqg
    setcfg  len, {{L}}
    rdmem   $gamma, $gamma
    rdmem   $beta,  $beta
    setcfg  len, $BYTES
    rdmem   $src, $src

    li      $c8,   {{C8}}
    li      $t8,   {{T8}}
    li      $t32,  {{T32}}
    li      $w0,   {{W0}}
    li      $negm, {{NEGM}}
    li      $rval, {{RVAL}}
    li      $rows, {{R}}
    li      $ll,   {{L}}

    setcfg  vlen, {{L}}                     ; every vector op below walks one row
    li      $r, 0
$rloop:
    cmps    $r, $rows
    bge     $rdone
    muls    $rowsrc, $r, $ll
    adds    $rowsrc, $rowsrc, $src
    muls    $rowdst, $r, $ll
    adds    $rowdst, $rowdst, $dst

    ; ---- mean: mu = trunc(S / L), by binary long division ----
    redsum  $w0, $rowsrc
    loads   $v, $w0
    li      $sgn, 0
    cmps    $v, r0
    bge     $vpos
    subs    $v, r0, $v                      ; work with |S|, re-sign at the end
    li      $sgn, 1
$vpos:
    li      $q,  0
    li      $tp, $TBLTOP
$dloop:
    cmps    $tp, $tbl
    blt     $ddone
    loads   $bb, $tp                        ; ...the next power of two, descending
    adds    $tt, $q, $bb
    muls    $uu, $tt, $ll
    cmps    $v, $uu
    blt     $dskip                          ; t*L > |S| -> this bit stays clear
    adds    $q, $tt, r0
$dskip:
    subs    $tp, $tp, $four
    jmp     $dloop
$ddone:
    cmps    $sgn, r0
    beq     $mpos
    subs    $q, r0, $q
$mpos:
    subs    $v, r0, $q
    stores  $negm, $v                       ; -mu, broadcastable

    ; ---- centre, and narrow so the VPU can read it back ----
    sadd    $t32, $rowsrc, $negm            ; x_i - mu   (int32)
    requant $c8, $t32, $rq1                 ; int8

    ; ---- R = floor(sqrt(sum c^2)), same loop with f(t) = t*t ----
    vecdot  $w0, $c8, $c8
    loads   $v, $w0
    li      $q,  0
    li      $tp, $TBLTOP
$sloop:
    cmps    $tp, $tbl
    blt     $sdone
    loads   $bb, $tp
    adds    $tt, $q, $bb
    muls    $uu, $tt, $tt
    cmps    $v, $uu
    blt     $sskip
    adds    $q, $tt, r0
$sskip:
    subs    $tp, $tp, $four
    jmp     $sloop
$sdone:
    cmps    $q, r0
    bne     $rnz
    li      $q, 1                           ; a constant row: divide by 1, not 0
$rnz:
    stores  $rval, $q

    ; ---- normalize, scale, shift ----
    sdiv    $t32, $c8, $rval                ; Q15
    requant $t8,  $t32, $rqy                ; int8 at the output scale
    vecemul $t32, $t8, $gamma
    requant $t8,  $t32, $rqg
    vecadd  $t32, $t8, $beta
    requant $rowdst, $t32, $rq1

    adds    $r, $r, $one
    jmp     $rloop
$rdone:
    setcfg  len, $BYTES
    wrmem   $dst, $dst
