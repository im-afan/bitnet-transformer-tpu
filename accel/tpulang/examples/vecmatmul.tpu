; vecmatmul.tpu — a whole attention score block as ONE instruction.
;
; examples/vpu_matmul.tpu builds S = Q @ K^T out of individual `vecdot`s, with a
; hand-written T x T loop nest around them: ~50 instructions of index and address
; arithmetic to drive 1024 dot products. `vecmatmul` is that loop nest in
; hardware (docs/macro_ops.md §5.3).
;
; This is *not* something the MXU could take over. The MXU multiplies int8
; activations by **ternary** weights; in attention both operands are int8
; activations computed at run time, so Q@K^T and P@V cannot use it at all. The
; VPU is the only unit that can, which is why collapsing this loop matters as
; much as collapsing the matmul tile loop.
;
;     S[t][s] = sum_d Q[t][d] * K[s][d]      t < vrows, s < vcols, d < vlen
;
; K is read row-major and contracted over its own rows, so K^T is never
; materialized — the transpose is implicit in the loop order, exactly as in
; vpu_matmul.tpu.
;
; The geometry deliberately uses **vrows != vcols**. A square block is the
; prefill case; decode attends one query against t+1 keys, so the two counts are
; separate config registers and this test would pass just as well with a square
; one only if they were wrongly aliased.
;
;     python ../assembler.py vecmatmul.tpu --listing
;     python ../gen_vectors.py -p examples/vecmatmul.tpu
;
; Self-contained over DRAM (identical DRAM/scratchpad addresses) like the rest.

; ---- geometry ----------------------------------------------------------------
.equ TQ     12          ; query rows  (vrows)
.equ TK     20          ; key rows    (vcols) — deliberately != TQ
.equ DH     16          ; head dim = contraction length (vlen)

; ---- strides (bytes) ---------------------------------------------------------
.equ QROW   DH          ; Q row stride: DH int8   = 16
.equ KROW   DH          ; K row stride: DH int8   = 16
.equ SROW   TK * 4      ; S row stride: TK int32  = 80

; ---- addresses (same in DRAM and scratchpad) ---------------------------------
.equ Q      0x0000      ; Q[TQ][DH] int8            (192 bytes)
.equ K      0x0400      ; K[TK][DH] int8            (320 bytes)
.equ S      0x1000      ; S[TQ][TK] int32           (960 bytes)

.equ Q_BYTES  TQ * DH       ; 192
.equ K_BYTES  TK * DH       ; 320
.equ S_BYTES  TQ * TK * 4   ; 960

.reg q      r1
.reg k      r2
.reg s      r3

    li      q, Q
    li      k, K
    li      s, S

    ; ---- stage operands in ---------------------------------------------------
    setcfg  len, Q_BYTES
    rdmem   q, q
    setcfg  len, K_BYTES
    rdmem   k, k

    ; ---- describe the block --------------------------------------------------
    setcfg  vlen,  DH       ; contract over the head dimension
    setcfg  vrows, TQ       ; query rows
    setcfg  vcols, TK       ; key rows  (independent of vrows)
    setcfg  vrow0, QROW     ; how to step Q, K and S
    setcfg  vrow1, KROW
    setcfg  vcrow, SROW

    vecmatmul s, q, k       ; S = Q @ K^T, all TQ*TK dot products

    ; ---- spill ---------------------------------------------------------------
    setcfg  len, S_BYTES
    wrmem   s, s
    halt
