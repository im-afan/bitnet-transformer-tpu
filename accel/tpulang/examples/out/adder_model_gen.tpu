; adder_model — the whole adder_ternary_vanilla forward pass, four layers and the ternary head, in one program
; generated by pytpu.py — edit the generator, not this file

.equ T          32
.equ D          128
.equ HEADS      4
.equ DH         32
.equ D3         0x180
.equ F          128
.equ VOCAB      13
.equ LAYERS     4
.equ ROWS       8
.equ COLS       8
.equ VPAD       16
.equ KTD        16
.equ NTD        16
.equ NTV        2
.equ KTDH       4
.equ NTT        4
.equ KTT        4
.equ NTDH       4
.equ CHUNK      0x200
.equ PKCH       128
.equ NCHUNK     8
.equ AROW       128
.equ WCOL       32
.equ TCOL       8
.equ KHOFF      8
.equ VHOFF      0x100
.equ CROWD      0x200
.equ SROW       128
.equ LROW       64
.equ WBUF       0
.equ Q8         0x3000
.equ K8         0x4000
.equ V8         0x5000
.equ VT         0x6000
.equ X          0x7000
.equ T1         0x8000
.equ T2         0x9000
.equ S32        0xa000
.equ TMP32      0xb000
.equ S8         0xb800
.equ P8         0xbc00
.equ KTP        0xc000
.equ VTP        0xc400
.equ MASK       0xc800
.equ RQW        0xcc00
.equ RQ_Q       0xcc00
.equ RQ_K       0xcc04
.equ RQ_KT      0xcc08
.equ RQ_V       0xcc0c
.equ RQ_VT      0xcc10
.equ RQ_S       0xcc14
.equ RQ_ID      0xcc18
.equ RQ_P       0xcc1c
.equ RQ_A       0xcc20
.equ RQ_O       0xcc24
.equ RQ_XO      0xcc28
.equ RQ_X1      0xcc2c
.equ RQ_H       0xcc30
.equ RQ_HR      0xcc34
.equ RQ_F       0xcc38
.equ RQ_X2      0xcc3c
.equ D_XIN      0
.equ D_MASK     0x1000
.equ D_A8       0x1400
.equ D_VT       0x2400
.equ D_WFC      0x3400
.equ D_LOG      0x3c00
.equ D_L0       0x5000
.equ LSTRIDE    0x7400
.equ O_WQKV     0
.equ O_WO       0x3000
.equ O_W1       0x4000
.equ O_W2       0x5000
.equ O_RQW      0x6000
.equ O_XOUT     0x6400
.equ B_WQKV     0x3000
.equ B_WD       0x1000
.equ B_ACT      0x1000
.equ B_VT       0x1000
.equ B_SQ       0x400
.equ B_TRIT     0x400
.equ B_RQW      64
.equ B_WFC      0x200
.equ B_LOG      0x800

.reg dram_p     r1
.reg rq_word    r2
.reg buf_a      r3
.reg buf_b      r4
.reg chunk_b    r5
.reg pack_b     r6
.reg head_i8    r7
.reg head_kt    r8
.reg head_vt    r9
.reg wgt_win    r10
.reg x_res      r11
.reg acc_i32    r12
.reg scr_lo     r13
.reg scr_hi     r14
.reg att_lo     r15
.reg att_hi     r16
.reg msk_lo     r17
.reg msk_hi     r18
.reg lay_base   r19
.reg layer_i    r20
.reg k_LAYERS   r21
.reg k_1        r22
.reg i          r23
.reg k_NCHUNK   r24
.reg i1         r23
.reg q_head     r23
.reg kt_head    r25
.reg vt_head    r26
.reg a_head     r27
.reg h          r28
.reg k_HEADS    r29
.reg i2         r23
.reg i3         r23
.reg i4         r23
.reg i5         r23
.reg log_i32    r20

    li          chunk_b, CHUNK
    li          pack_b, PKCH
    li          head_i8, DH
    li          head_kt, KHOFF
    li          head_vt, VHOFF
    li          wgt_win, WBUF
    li          x_res, X
    li          acc_i32, TMP32
    li          scr_lo, S8
    li          scr_hi, S8 + CHUNK
    li          att_lo, P8
    li          att_hi, P8 + CHUNK
    li          msk_lo, MASK
    li          msk_hi, MASK + CHUNK
    li          k_LAYERS, LAYERS
    li          k_1, 1
    li          k_NCHUNK, NCHUNK
    li          k_HEADS, HEADS

    ; =======================================================================
    ; 0. X and the causal mask, loaded once for the whole model.
    ; =======================================================================
    li          dram_p, D_XIN
    setcfg      len, B_ACT
    rdmem       x_res, dram_p
    li          dram_p, D_MASK
    setcfg      len, B_SQ
    rdmem       msk_lo, dram_p
    setcfg      tlen, T
    li          lay_base, D_L0
    li          layer_i, 0
L0_top:
    cmps        layer_i, k_LAYERS
    bge         L0_end
      ; this layer's 16 requant words, into the fixed RQW slot
      li          dram_p, O_RQW
      adds        dram_p, dram_p, lay_base
      li          buf_a, RQW
      setcfg      len, B_RQW
      rdmem       buf_a, dram_p
      ; 1. Q, K, V — three ternary matmuls out of one fused block
      setcfg      len, B_WQKV
      rdmem       wgt_win, lay_base
      setcfg      arow, AROW
      setcfg      wcol, WCOL
      setcfg      ktiles, KTD
      setcfg      ntiles, NTD
      setcfg      crow, CROWD
      li          buf_a, Q8
      setcfg      scalar, RQ_Q
      matmul_t.rq buf_a, x_res, wgt_win
      li          buf_a, K8
      li          buf_b, WBUF + D * WCOL
      setcfg      scalar, RQ_K
      matmul_t.rq buf_a, x_res, buf_b
      li          buf_a, V8
      li          buf_b, WBUF + 2 * D * WCOL
      setcfg      scalar, RQ_V
      matmul_t.rq buf_a, x_res, buf_b
      ; 2. K -> trits.  A packed row of K *is* a weight column of K^T,
      ;    so Q @ K^T needs no transpose at all.
      setcfg      vlen, CHUNK
      li          rq_word, RQ_KT
      li          buf_a, K8
      li          buf_b, KTP
      li          i, 0
L1_top:
      cmps        i, k_NCHUNK
      bge         L1_end
        tquant      buf_b, buf_a, rq_word
        adds        buf_a, buf_a, chunk_b
        adds        buf_b, buf_b, pack_b
      adds        i, i, k_1
      jmp         L1_top
L1_end:
      ; 3. V^T in one transposing DMA, then V^T -> trits
      li          buf_a, V8
      li          dram_p, D_VT
      setcfg      tcols, D
      setcfg      tsrow, AROW
      setcfg      tdrow, T
      setcfg      len, B_VT
      wrmem.t     buf_a, dram_p
      li          buf_a, VT
      rdmem       buf_a, dram_p
      setcfg      vlen, CHUNK
      li          rq_word, RQ_VT
      li          buf_b, VTP
      li          i1, 0
L2_top:
      cmps        i1, k_NCHUNK
      bge         L2_end
        tquant      buf_b, buf_a, rq_word
        adds        buf_a, buf_a, chunk_b
        adds        buf_b, buf_b, pack_b
      adds        i1, i1, k_1
      jmp         L2_top
L2_end:
      ; 4. Attention, one head at a time — both matmuls on the MXU
      li          q_head, Q8
      li          kt_head, KTP
      li          vt_head, VTP
      li          a_head, T1
      li          h, 0
L3_top:
      cmps        h, k_HEADS
      bge         L3_end
        setcfg      arow, AROW
        setcfg      wcol, WCOL
        setcfg      crow, SROW
        setcfg      ktiles, KTDH
        setcfg      ntiles, NTT
        setcfg      scalar, RQ_S
        matmul_t.rq scr_lo, q_head, kt_head
        setcfg      vlen, CHUNK
        li          rq_word, RQ_ID
        vecadd      acc_i32, scr_lo, msk_lo
        requant     scr_lo, acc_i32, rq_word
        vecadd      acc_i32, scr_hi, msk_hi
        requant     scr_hi, acc_i32, rq_word
        li          rq_word, RQ_P
        relu        acc_i32, scr_lo
        requant     att_lo, acc_i32, rq_word
        relu        acc_i32, scr_hi
        requant     att_hi, acc_i32, rq_word
        setcfg      arow, T
        setcfg      wcol, TCOL
        setcfg      crow, CROWD
        setcfg      ktiles, KTT
        setcfg      ntiles, NTDH
        setcfg      scalar, RQ_A
        matmul_t.rq a_head, att_lo, vt_head
        adds        q_head, q_head, head_i8
        adds        kt_head, kt_head, head_kt
        adds        vt_head, vt_head, head_vt
        adds        a_head, a_head, head_i8
      adds        h, h, k_1
      jmp         L3_top
L3_end:
      ; 5. O = A @ Wo, then the residual X <- norm1(X + (O + X))
      li          buf_a, T1
      li          dram_p, D_A8
      setcfg      len, B_ACT
      wrmem       buf_a, dram_p
      li          dram_p, O_WO
      adds        dram_p, dram_p, lay_base
      setcfg      len, B_WD
      rdmem       wgt_win, dram_p
      setcfg      arow, AROW
      setcfg      wcol, WCOL
      setcfg      ktiles, KTD
      setcfg      ntiles, NTD
      setcfg      crow, CROWD
      li          buf_a, T1
      li          buf_b, T2
      setcfg      scalar, RQ_O
      matmul_t.rq buf_b, buf_a, wgt_win
      setcfg      vlen, CHUNK
      li          rq_word, RQ_XO
      li          buf_a, X
      li          buf_b, T2
      li          i2, 0
L4_top:
      cmps        i2, k_NCHUNK
      bge         L4_end
        vecadd      acc_i32, buf_a, buf_b
        requant     buf_b, acc_i32, rq_word
        adds        buf_a, buf_a, chunk_b
        adds        buf_b, buf_b, chunk_b
      adds        i2, i2, k_1
      jmp         L4_top
L4_end:
      li          rq_word, RQ_X1
      li          buf_a, X
      li          buf_b, T2
      li          i3, 0
L5_top:
      cmps        i3, k_NCHUNK
      bge         L5_end
        vecadd      acc_i32, buf_a, buf_b
        dyt         buf_a, acc_i32, rq_word
        adds        buf_a, buf_a, chunk_b
        adds        buf_b, buf_b, chunk_b
      adds        i3, i3, k_1
      jmp         L5_top
L5_end:
      ; 6. Feed-forward: X <- norm2(X1 + W2(relu(W1(X1))))
      li          dram_p, O_W1
      adds        dram_p, dram_p, lay_base
      setcfg      len, B_WD
      rdmem       wgt_win, dram_p
      li          buf_a, T1
      setcfg      scalar, RQ_H
      matmul_t.rq buf_a, x_res, wgt_win
      setcfg      vlen, CHUNK
      li          rq_word, RQ_HR
      li          buf_a, T1
      li          buf_b, T2
      li          i4, 0
L6_top:
      cmps        i4, k_NCHUNK
      bge         L6_end
        relu        acc_i32, buf_a
        requant     buf_b, acc_i32, rq_word
        adds        buf_a, buf_a, chunk_b
        adds        buf_b, buf_b, chunk_b
      adds        i4, i4, k_1
      jmp         L6_top
L6_end:
      li          dram_p, O_W2
      adds        dram_p, dram_p, lay_base
      setcfg      len, B_WD
      rdmem       wgt_win, dram_p
      li          buf_a, T1
      li          buf_b, T2
      setcfg      scalar, RQ_F
      matmul_t.rq buf_a, buf_b, wgt_win
      setcfg      vlen, CHUNK
      li          rq_word, RQ_X2
      li          buf_a, X
      li          buf_b, T1
      li          i5, 0
L7_top:
      cmps        i5, k_NCHUNK
      bge         L7_end
        vecadd      acc_i32, buf_a, buf_b
        dyt         buf_a, acc_i32, rq_word
        adds        buf_a, buf_a, chunk_b
        adds        buf_b, buf_b, chunk_b
      adds        i5, i5, k_1
      jmp         L7_top
L7_end:
      ; 7. Checkpoint this layer's X, then advance the block base
      li          dram_p, O_XOUT
      adds        dram_p, dram_p, lay_base
      setcfg      len, B_ACT
      wrmem       x_res, dram_p
      li          dram_p, LSTRIDE
      adds        lay_base, lay_base, dram_p
    adds        layer_i, layer_i, k_1
    jmp         L0_top
L0_end:
    ; =======================================================================
    ; 8. Output head: logits = X @ fc.weight
    ; =======================================================================
    li          dram_p, D_WFC
    setcfg      len, B_WFC
    rdmem       wgt_win, dram_p
    setcfg      arow, AROW
    setcfg      wcol, WCOL
    setcfg      ktiles, KTD
    setcfg      ntiles, NTV
    setcfg      crow, LROW
    li          log_i32, S32
    matmul_t    log_i32, x_res, wgt_win
    li          dram_p, D_LOG
    setcfg      len, B_LOG
    wrmem       log_i32, dram_p
    halt
