; highmem_dma.tpu — DMA above the first 64 KB of DRAM.
;
; The external SRAM is 512 KB (MEM_ADDR_W = 19) and the UART host always reached
; all of it, but until recently `scalar_unit.sv` truncated a rdmem/wrmem DRAM
; address to ADDR_W = 16 bits, so a *program* could only name the low 64 KB.
; That is fixed; this is the test, and nothing else in the tree covers it.
;
; It pins down two things that fail in *different* ways, so a regression in
; either is unambiguous:
;
;   1. **The DRAM address really is MEM_ADDR_W wide.** Every output below lands
;      at 0x10000 or above. If the address were still truncated to 16 bits the
;      writes would alias down into the low window and the reference would find
;      nothing at the high addresses at all — a missing-byte error, not a subtly
;      wrong value.
;
;   2. **`li` zero-extends.** No 16-bit immediate can name 0x10000, so the base
;      is built as `li hi, 0x8000` + `adds hi, hi, hi` — the idiom every program
;      needs for high DRAM. Under the old sign-extending `li`, 0x8000 loaded as
;      0xFFFF8000 and that doubling would land at 0x70000 instead of 0x10000.
;      This is not hypothetical: it is what silently broke vpu_matmul.tpu, whose
;      S8 tensor sits at DRAM 0x8000, the moment the address stopped being
;      masked to 16 bits.
;
; Both a linear and a transposed transfer are exercised at the high base,
; because the two use different address generators (dma.sv §Transpose mode) and
; only the transposed one crosses the scratchpad/DRAM masking boundary in both
; directions. A round trip back down to low DRAM checks that a *fill* from a
; high address works too, not just a spill.
;
;     python ../assembler.py highmem_dma.tpu --listing
;     python ../torch_ref.py -p examples/highmem_dma.tpu
;     python ../gen_vectors.py -p examples/highmem_dma.tpu

; ---- geometry --------------------------------------------------------------
.equ R       8              ; source rows
.equ C       12             ; source columns (!= R, so a transpose is visible)
.equ N       R * C          ; 96 bytes

; ---- low DRAM / scratchpad -------------------------------------------------
.equ SRC     0x0400         ; [R][C] int8 source, host-seeded in low DRAM
.equ BACK    0x0800         ; low DRAM: what came back down from high DRAM
.equ SPAD    0x1000         ; scratchpad staging for SRC
.equ SPADB   0x2000         ; scratchpad staging for the read-back

; ---- high DRAM -------------------------------------------------------------
; HI_HALF is the largest power of two a 16-bit immediate can hold; the program
; doubles it to reach 0x10000. The offsets are added on top at run time.
.equ HI_HALF 0x8000
.equ LIN_OFF 0x0100         ; linear copy      -> 0x10100
.equ T_OFF   0x0800         ; transposed copy  -> 0x10800

.reg src   r1
.reg back  r2
.reg spad  r3
.reg spadb r4
.reg hi    r5
.reg lin   r6
.reg trn   r7
.reg tmp   r8

    li      src,   SRC
    li      back,  BACK
    li      spad,  SPAD
    li      spadb, SPADB

    ; ---- build the high base: hi = 0x10000 --------------------------------
    ; No immediate can name it, and this doubling is only correct because `li`
    ; zero-extends (see the header).
    li      hi,  HI_HALF
    adds    hi,  hi, hi
    li      tmp, LIN_OFF
    adds    lin, hi, tmp
    li      tmp, T_OFF
    adds    trn, hi, tmp

    ; ---- SRC (low DRAM) -> scratchpad -------------------------------------
    setcfg  len, N
    rdmem   spad, src

    ; ---- scratchpad -> HIGH DRAM, linear ----------------------------------
    wrmem   spad, lin

    ; ---- scratchpad -> HIGH DRAM, transposed [R][C] -> [C][R] -------------
    setcfg  tcols, C            ; C elements per source row...
    setcfg  tsrow, C            ; ...from dense rows
    setcfg  tdrow, R            ; destination rows are R long
    wrmem.t spad, trn

    ; ---- HIGH DRAM -> scratchpad -> low DRAM ------------------------------
    ; The fill direction, from an address a 16-bit register could not hold.
    rdmem   spadb, lin
    wrmem   spadb, back
    halt
