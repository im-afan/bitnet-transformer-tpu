; @primitive matmul_i8
; @clobbers r1-r24, cfg vlen/len
;
; O[h,m,n] int32 = sum_k A[h,m,k] * B[h,n,k]     — a batched int8 x int8 matmul
; on the VPU, one `vecdot` per (h, m, n) with vlen = KLEN.
;
; The MXU multiplies int8 activations by *ternary* weights, which is the wrong
; shape for attention: in prefill both operands are int8 activations and neither
; is a stored weight. So attention's two matmuls run here instead. `vecdot`
; contracts two int8 vectors into one int32 scalar, so B is consumed as B^T
; without ever being transposed — the inner loop walks B's rows.
;
; Every axis is addressed by an explicit byte stride, which is what lets one
; template serve both attention matmuls even though their operands are strided
; sub-blocks of larger tensors:
;
;     element        address
;     A[h,m,k]       A + h*AH + m*AM + k
;     B[h,n,k]       B + h*BH + n*BN + k
;     O[h,m,n]       O + h*OH + m*OM + n*4      (int32)
;
;   S = Q K^T   A=Q slice of QKV, AH=head_dim, AM=3*d;  B=K slice, BH=head_dim,
;               BN=3*d;  KLEN=head_dim;  O=S32, OH=T*T*4, OM=T*4
;   A = P V^T   A=P, AH=T*T, AM=T;  B=V^T, BH=head_dim*T, BN=T;  KLEN=T;
;               O=AO32, OH=head_dim*4, OM=d*4
;
; Note the first one: a head's slice of Q is *not* contiguous, but each
; (head, token) row is head_dim contiguous bytes, which is all `vecdot` needs.
; So heads never have to be un-interleaved out of the [T, 3d] layout the MXU
; produced. The head loop is inside this template, so head count costs no
; instructions.
;
; Staging is explicit: two DRAM->scratchpad fills (the second may be 0 bytes),
; then the whole O span is spilled back. O must therefore be a dense O_BYTES
; region — the strides may not leave gaps inside it.
;
; @param IN0        DRAM address of the first region to stage in
; @param IN0_BYTES  bytes to fill from IN0
; @param IN1        DRAM address of the second region (may equal IN0)
; @param IN1_BYTES  bytes to fill from IN1 (0 = no second fill)
; @param A          base address of A
; @param AH         byte stride of A's head axis
; @param AM         byte stride of A's row axis
; @param B          base address of B
; @param BH         byte stride of B's head axis
; @param BN         byte stride of B's row axis
; @param O          base address of O (int32)
; @param OH         byte stride of O's head axis
; @param OM         byte stride of O's row axis
; @param O_BYTES    dense byte span of O, spilled to DRAM at the end
; @param H          heads (batch axis)
; @param M          rows of A per head
; @param N          rows of B per head
; @param KLEN       contraction length in elements (= cfg vlen)

.reg $s0     r1
.reg $s1     r2
.reg $a      r3
.reg $b      r4
.reg $o      r5
.reg $h      r6
.reg $m      r7
.reg $n      r8
.reg $hh     r9
.reg $mm     r10
.reg $nn     r11
.reg $one    r12
.reg $four   r13
.reg $ahs    r14
.reg $ams    r15
.reg $bhs    r16
.reg $bns    r17
.reg $ohs    r18
.reg $oms    r19
.reg $ab     r20            ; A + h*AH
.reg $bb     r21            ; B + h*BH
.reg $ob     r22            ; O + h*OH
.reg $am     r23            ; &A[h,m,0]
.reg $om     r24            ; &O[h,m,0]
.reg $bn     r25            ; &B[h,n,0]
.reg $dst    r26            ; &O[h,m,n]

    ; ---- stage operands: DRAM -> scratchpad (identical addresses) ----
    li      $s0, {{IN0}}
    setcfg  len, {{IN0_BYTES}}
    rdmem   $s0, $s0
    li      $s1, {{IN1}}
    setcfg  len, {{IN1_BYTES}}
    rdmem   $s1, $s1

    li      $a,    {{A}}
    li      $b,    {{B}}
    li      $o,    {{O}}
    li      $hh,   {{H}}
    li      $mm,   {{M}}
    li      $nn,   {{N}}
    li      $one,  1
    li      $four, 4
    li      $ahs,  {{AH}}
    li      $ams,  {{AM}}
    li      $bhs,  {{BH}}
    li      $bns,  {{BN}}
    li      $ohs,  {{OH}}
    li      $oms,  {{OM}}

    setcfg  vlen, {{KLEN}}          ; every vecdot contracts over KLEN elements
    li      $h, 0
$hloop:
    cmps    $h, $hh
    bge     $hdone
    muls    $ab, $h, $ahs
    adds    $ab, $ab, $a
    muls    $bb, $h, $bhs
    adds    $bb, $bb, $b
    muls    $ob, $h, $ohs
    adds    $ob, $ob, $o
    li      $m, 0

$mloop:
    cmps    $m, $mm
    bge     $mdone
    muls    $am, $m, $ams
    adds    $am, $am, $ab               ; &A[h,m,0]
    muls    $om, $m, $oms
    adds    $om, $om, $ob               ; &O[h,m,0]
    li      $n, 0

$nloop:
    cmps    $n, $nn
    bge     $ndone
    muls    $bn, $n, $bns
    adds    $bn, $bn, $bb               ; &B[h,n,0]
    muls    $dst, $n, $four
    adds    $dst, $dst, $om             ; &O[h,m,n]  (int32 lane)
    vecdot  $dst, $am, $bn
    adds    $n, $n, $one
    jmp     $nloop

$ndone:
    adds    $m, $m, $one
    jmp     $mloop
$mdone:
    adds    $h, $h, $one
    jmp     $hloop
$hdone:
    ; ---- spill the whole int32 result block: scratchpad -> DRAM ----
    setcfg  len, {{O_BYTES}}
    wrmem   $o, $o
