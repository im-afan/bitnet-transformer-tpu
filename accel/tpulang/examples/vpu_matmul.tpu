; vpu_matmul.tpu — attention scores S = Q @ K^T computed on the VPU, not the MXU.
;
; The MXU multiplies int8 activations by *ternary* weights, which is the wrong
; shape for attention: in prefill both operands are int8 activations and neither
; one is a stored weight. So the scores are built out of VPU reductions instead —
; one `vecdot` per (query, key) pair, contracting over the head dimension:
;
;     S32[t][s] = Σ_d Q[t][d] · K[s][d]        vecdot, vlen = D_HEAD
;
; That is the whole trick. `vecdot` is a dot product of two int8 vectors into one
; int32 scalar, so a T x T score block is just a T x T loop nest around it — and
; because the contraction runs over d with K read row-major, **K^T is never
; materialised**: the inner loop walks K's rows and the transpose is implicit.
;
; Each score row is then narrowed back to int8 for softmax to consume:
;
;     S8[t][s] = requant(S32[t][s])            requant, vlen = T
;
; VPU compute ops write int32 and read int8 (vpu.md §Datatypes), so `requant` is
; not decoration here — it is the only thing that turns a vector the VPU produced
; into a vector the VPU can consume. Its {m0,n} comes from the word at its *src1*
; operand, not from cfg `scalar` (that one is the MXU's).
;
;     python ../assembler.py vpu_matmul.tpu --listing
;     python ../torch_ref.py -p vpu_matmul.tpu    ; check against PyTorch
;
; Self-contained over DRAM, like relu_layer.tpu: every tensor uses the same
; address in DRAM and in the scratchpad, so `rdmem a,a` stages the operands in
; and `wrmem a,a` spills the results back out to the host.
;
; **Why T = 32.** The int32 score block is T*T*4 bytes, so it — not Q or K — is
; what bounds T against the 64 KB scratchpad: T = 128 would want the entire 64 KB
; for S32 alone, leaving no room for the operands. Real prefill tiles the key
; axis for exactly that reason (tiled_matmul.tpu has the loop structure); this
; example keeps one full T x T block resident so the dataflow stays legible.

; ---- geometry ----------------------------------------------------------------
.equ T      32          ; token count (queries and keys — a square prefill block)
.equ D_HEAD 16          ; head dimension = the contraction length

; ---- addresses (the same in DRAM and in the scratchpad) -----------------------
.equ Q      0x0000      ; Q[t][d] int8,  row-major
.equ K      0x1000      ; K[s][d] int8,  row-major  (never transposed)
.equ RQW    0x2000      ; requant {m0,n} word (int32)
.equ S32    0x3000      ; S[t][s] int32, raw scores
.equ S8     0x8000      ; S[t][s] int8,  requantized scores — softmax's input

; ---- byte sizes ---------------------------------------------------------------
.equ QK_BYTES   T * D_HEAD  ; = 512, each of Q and K
.equ RQW_BYTES  4           ; one int32 word
.equ S32_BYTES  T * T * 4   ; = 4096
.equ S8_BYTES   T * T       ; = 1024
.equ SROW32     T * 4       ; = 128, bytes per int32 score row

.reg q      r1
.reg k      r2
.reg rqw    r3
.reg s32    r4
.reg s8     r5
.reg qi     r6          ; query index  (row of S)
.reg ki     r7          ; key index    (column of S)
.reg tcount r8          ; T
.reg one    r9
.reg dh     r10         ; D_HEAD — also the int8 row stride of Q and K
.reg four   r11
.reg srow32 r12         ; SROW32
.reg qrow   r13         ; &Q[qi][0]
.reg krow   r14         ; &K[ki][0]
.reg row32  r15         ; &S32[qi][0]
.reg row8   r16         ; &S8[qi][0]
.reg dst    r17         ; &S32[qi][ki]

    ; ---- constants ----
    li  q,      Q
    li  k,      K
    li  rqw,    RQW
    li  s32,    S32
    li  s8,     S8
    li  tcount, T
    li  one,    1
    li  dh,     D_HEAD
    li  four,   4
    li  srow32, SROW32

    ; ---- stage inputs: DRAM -> scratchpad (identical addresses) ----
    setcfg  len, QK_BYTES
    rdmem   q, q
    rdmem   k, k
    setcfg  len, RQW_BYTES
    rdmem   rqw, rqw

    li  qi, 0
qloop:
    cmps    qi, tcount
    bge     qdone
    muls    qrow, qi, dh            ; qrow  = Q   + qi*D_HEAD
    adds    qrow, qrow, q
    muls    row32, qi, srow32       ; row32 = S32 + qi*(T*4)
    adds    row32, row32, s32

    setcfg  vlen, D_HEAD            ; vecdot contracts over the head dim
    li      ki, 0
kloop:
    cmps    ki, tcount
    bge     kdone
    muls    krow, ki, dh            ; krow = K + ki*D_HEAD
    adds    krow, krow, k
    muls    dst, ki, four           ; dst  = row32 + ki*4  (int32 lane)
    adds    dst, dst, row32
    vecdot  dst, qrow, krow         ; S32[qi][ki] = Σ_d Q[qi][d]·K[ki][d]
    adds    ki, ki, one
    jmp     kloop

kdone:
    ; ---- narrow this score row for softmax: int32 -> int8 ----
    muls    row8, qi, tcount        ; row8 = S8 + qi*T
    adds    row8, row8, s8
    setcfg  vlen, T                 ; requant walks the row, not the head dim
    requant row8, row32, rqw
    adds    qi, qi, one
    jmp     qloop

qdone:
    ; ---- store results: scratchpad -> DRAM ----
    setcfg  len, S32_BYTES
    wrmem   s32, s32
    setcfg  len, S8_BYTES
    wrmem   s8, s8
    halt
