; transpose_dma.tpu — a transpose as ONE instruction, in both directions.
;
; Attention's second matmul, P @ V, contracts over *keys*. `vecdot` (and so
; `vecmatmul`) contracts over each operand's contiguous axis, and V's key axis is
; its row axis, so V has to be transposed first — and no loop order avoids it:
; computing A^T instead just asks for V^T from the other side.
;
; Without a transposing DMA the only way to do that is docs/dma.md's byte move:
; `rdmem`/`wrmem` with len = 1 in a two-deep loop, one dispatch per byte, ~8k
; dispatches for a [24][128] V. `.t` does the whole thing in one, by walking the
; source row-major and the destination transposed (docs/dma.md §5):
;
;     source      read    : src + r*tsrow + c        (cfg tcols, cfg tsrow)
;     destination written : dst + c*tdrow + r        (cfg tdrow)
;
; The geometry here is the real one, scaled down: Q, K and V come out of a single
; fused projection as one [T][3D] block, so the slice to transpose is D columns
; of a D3-byte row — which is exactly what `tsrow` is for. Nothing has to be
; un-interleaved first, and the result is a dense [D][T] ready for `vecmatmul`.
;
; Both directions are exercised, because the flag means the same thing in each
; and only the roles of DRAM and scratchpad swap:
;
;     wrmem.t  scratch V slice  -> DRAM V^T     (spill, transposed)
;     rdmem.t  DRAM   Q slice   -> scratch Q^T  (fill,  transposed)
;
;     python ../assembler.py transpose_dma.tpu --listing
;     python ../gen_vectors.py -p examples/transpose_dma.tpu
;
; Self-contained over DRAM (identical DRAM/scratchpad addresses) like the rest —
; with the one difference the mode forces: a transpose cannot be done in place,
; so the source and destination tensors are distinct regions.

; ---- geometry ----------------------------------------------------------------
.equ T      12          ; tokens
.equ D      16          ; features per projection (2 heads x 8)
.equ D3     D * 3       ; fused Q|K|V row: 48 bytes

; ---- addresses (same in DRAM and scratchpad) ---------------------------------
.equ QKV    0x0000      ; QKV[T][D3] int8, row-major        (576 bytes)
.equ VT     0x0400      ; V^T[D][T]  int8                   (192 bytes)
.equ QT     0x0800      ; Q^T[D][T]  int8                   (192 bytes)

.equ QKV_BYTES  T * D3  ; 576
.equ SLICE      T * D   ; 192 — bytes in one projection's slice, either way up

.reg qkv    r1
.reg v      r2
.reg vt     r3
.reg qt     r4

    li      qkv, QKV
    li      v,   QKV + 2 * D    ; V's columns start two projections in
    li      vt,  VT
    li      qt,  QT

    ; ---- stage the fused block ----------------------------------------------
    setcfg  len, QKV_BYTES
    rdmem   qkv, qkv

    ; ---- describe the slice once, for both transposes ------------------------
    setcfg  tcols, D            ; D elements per source row...
    setcfg  tsrow, D3           ; ...taken from rows D3 bytes apart
    setcfg  tdrow, T            ; destination rows are T elements long
    setcfg  len,   SLICE

    ; ---- V^T: spill the scratchpad slice out, transposed ---------------------
    wrmem.t v, vt

    ; ---- Q^T: fill from DRAM, transposed. Same geometry; Q is the slice at
    ;      column 0, so the source base is the block base.
    rdmem.t qt, qkv

    ; ---- make Q^T host-visible (V^T already landed in DRAM) ------------------
    ; No `.t` here, so this is a plain linear spill even though tcols/tsrow/tdrow
    ; are still set from above: the mode is in the instruction, never in the
    ; config (docs/dma.md §5.3). `len` is still SLICE.
    wrmem   qt, qt
    halt
