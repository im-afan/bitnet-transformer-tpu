; tiled_matmul_hw.tpu — the whole tiled matmul as ONE instruction.
;
; examples/tiled_matmul.tpu computes an M x K @ K x N product by expanding the
; tile loops in software: 191 lines of cmps/branch/adds walking [mt][nt][kt],
; with the three-way matmul / matmul.acc / matmul.acc.rq flag dance to
; initialise, accumulate and finally narrow the int32 partials. Every one of
; those partials round-trips through the scratchpad between tiles.
;
; `matmul_t` does the same contraction in hardware (docs/macro_ops.md §4.2). The
; loop is n outer, k inner, so the partial sums stay in the MXU's result buffer
; for the whole contraction and reach the scratchpad exactly once per output
; tile — the int32 C traffic that dominated the software version disappears
; rather than being made faster.
;
; The layout is a flat row-major matrix rather than tiled_matmul.tpu's tile-major
; packing, because that is the point: the strides let the array address a window
; of a larger matrix in place, so no tile-shaped copy has to be staged.
;
;     A : M x K int8, row-major        arow = K
;     W : K x N trits, col-major 2b    wcol = K*2/8
;     C : M x N int32                  crow = N*4
;
; Both output forms are produced, from the same operands, to cover both store
; paths in one program: a plain int32 C, and a requantized int8 C. `crow` is the
; *int32* row stride for both — the requantized store derives its own N-byte
; stride as crow/4, which is why one config register covers both.
;
;     python ../assembler.py tiled_matmul_hw.tpu --listing
;     python ../gen_vectors.py -p examples/tiled_matmul_hw.tpu
;
; Self-contained over DRAM (identical DRAM/scratchpad addresses) like the rest.

; ---- geometry ----------------------------------------------------------------
.equ ROWS   8               ; MXU contraction dim per tile
.equ COLS   8               ; MXU output features per tile
.equ M      8               ; token rows      (<= 63: MXU TOK_W is 6 bits)
.equ KTILES 4               ; contraction tiles
.equ NTILES 2               ; output tiles
.equ K      KTILES * ROWS   ; = 32
.equ N      NTILES * COLS   ; = 16

; ---- strides (bytes) ---------------------------------------------------------
.equ AROW   K               ; A row stride: K int8              = 32
.equ WCOL   K * 2 // 8      ; W column stride: K trits packed   = 8
.equ CROW   N * 4           ; C row stride: N int32             = 64

; ---- addresses (same in DRAM and scratchpad) ---------------------------------
.equ A      0x0000          ; A[M][K]  int8                     (256 bytes)
.equ W      0x0400          ; W[K][N]  trits, col-major 2b      (128 bytes)
.equ RQW    0x0800          ; requant {m0,n} word (int32)       (4 bytes)
.equ C32    0x1000          ; C[M][N]  int32                    (512 bytes)
.equ C8     0x2000          ; C[M][N]  int8 (requantized)       (128 bytes)

.equ A_BYTES    M * K       ; 256
.equ W_BYTES    N * WCOL    ; 128
.equ RQW_BYTES  4
.equ C32_BYTES  M * N * 4   ; 512
.equ C8_BYTES   M * N       ; 128

.reg a      r1
.reg w      r2
.reg rqw    r3
.reg c32    r4
.reg c8     r5

    li      a,   A
    li      w,   W
    li      rqw, RQW
    li      c32, C32
    li      c8,  C8

    ; ---- stage operands in ---------------------------------------------------
    setcfg  len, A_BYTES
    rdmem   a, a
    setcfg  len, W_BYTES
    rdmem   w, w
    setcfg  len, RQW_BYTES
    rdmem   rqw, rqw

    ; ---- describe the problem once ------------------------------------------
    setcfg  tlen,   M       ; token rows in the output
    setcfg  arow,   AROW    ; how the operands are laid out...
    setcfg  wcol,   WCOL
    setcfg  crow,   CROW
    setcfg  ktiles, KTILES  ; ...and how many array-sized tiles they span
    setcfg  ntiles, NTILES
    setcfg  scalar, RQW     ; requant {m0,n} for the .rq form below

    ; ---- the entire M x K @ K x N contraction, twice -------------------------
    matmul_t     c32, a, w  ; C32 = A @ W                       (int32)
    matmul_t.rq  c8,  a, w  ; C8  = requant(A @ W)              (int8)

    ; ---- spill both results --------------------------------------------------
    setcfg  len, C32_BYTES
    wrmem   c32, c32
    setcfg  len, C8_BYTES
    wrmem   c8, c8
    halt
