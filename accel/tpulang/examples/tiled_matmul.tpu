; tiled_matmul.tpu — a full C = A @ W matmul whose A, W and C are all far larger
; than the on-chip scratchpad, streamed one tile at a time through fixed buffers.
;
; The MXU array is ROWS x COLS (8 x 8) and processes up to `tlen` tokens per pass,
; so a single `matmul` computes one output tile:
;
;     C_tile[T, COLS] += A_tile[T, ROWS] @ W_tile[ROWS, COLS]
;
; A general [M, K] @ [K, N] matmul is therefore three nested loops over tiles:
;
;     for mt in 0..MTILES:          ; block of T output tokens          (M axis)
;       for nt in 0..NTILES:        ; block of COLS output features     (N axis)
;         for kt in 0..KTILES:      ; contraction, accumulated in C      (K axis)
;           rdmem A_tile[mt,kt] -> ABUF     ; DRAM -> scratch, one tile
;           rdmem W_tile[kt,nt] -> WBUF     ; DRAM -> scratch, one tile
;           matmul[.acc[.rq]] CBUF, ABUF, WBUF
;         wrmem CBUF -> C_tile[mt,nt]       ; scratch -> DRAM, one tile
;
; The K flavours are the tile loop from the original example:
;     kt 0          : matmul            init int32 partial (no acc, no requant)
;     kt 1..K-2     : matmul.acc        C += this tile
;     kt K-1        : matmul.acc.rq     C += last tile, then requant int32->int8
;
; The point of THIS version: only the CURRENT tiles are ever resident. The
; scratchpad footprint is
;
;     ABUF (T*ROWS) + WBUF (COLS*ROWS*2/8) + CBUF (T*COLS*4) + RQW (4)
;         = 32       + 16                    + 128            + 4    = 180 bytes
;
; and it does NOT grow with MTILES/NTILES/KTILES — raise those and the DRAM
; working set grows without bound while the scratchpad stays a flat 180 B. (The
; old version staged the whole A and W spans up front, so the whole matrix had to
; fit in scratchpad.) This relies on a real DMA engine: rdmem/wrmem move bytes
; between external DRAM and scratchpad (dma.sv), so a scratch buffer address and
; its DRAM tile address differ — the "identical-address" trick of the smaller
; examples no longer applies here.
;
;     python ../assembler.py tiled_matmul.tpu --listing
;     python ../gen_vectors.py -p examples/tiled_matmul.tpu   ; verifies vs. reference
;
; Assumes KTILES >= 2 (there is a distinct init tile and a distinct requant tile).

; ---- array / problem geometry ------------------------------------------------
.equ ROWS   8               ; MXU contraction dim  (K per tile)
.equ COLS   8               ; MXU output features  (N per tile)
.equ T      4               ; tokens per matmul pass (cfg tlen; M per tile)
.equ MTILES 2               ; output token blocks   (M = MTILES*T)
.equ NTILES 2               ; output feature blocks (N = NTILES*COLS)
.equ KTILES 4               ; contraction tiles     (K = KTILES*ROWS)

; ---- tile byte sizes ---------------------------------------------------------
.equ WCOL   (ROWS * 2) // 8 ; packed ternary bytes per weight column (= 2)
.equ ATILE  T * ROWS        ; int8 A tile, row-major                 (= 32)
.equ WTILE  COLS * WCOL     ; ternary W tile, col-major 2b-packed    (= 16)
.equ CTILE  T * COLS        ; int8 C tile (requant output)           (= 32)
.equ CBUF_BYTES  T * COLS * 4  ; int32 C accumulator buffer          (= 128)

; ---- DRAM tile-strides (tile-major layout, see gen_vectors.py) ---------------
.equ ASTRIDE_M  KTILES * ATILE  ; advance A by one M-row of K tiles
.equ WSTRIDE_N  KTILES * WTILE  ; advance W by one N-col of K tiles

; ---- DRAM addresses (external; inputs seeded here, outputs land here) ---------
.equ A      0x1000          ; A tiles: [mt][kt], each ATILE bytes, row-major
.equ W      0x4000          ; W tiles: [nt][kt], each WTILE bytes, col-major
.equ C      0x6000          ; C tiles: [mt][nt], each CTILE bytes int8
.equ RQW    0x7000          ; requant {m0,n} word (int32)

; ---- scratchpad buffers (fixed, tiny; a separate space from DRAM) ------------
.equ ABUF   0x0000          ; one A tile
.equ WBUF   0x0100          ; one W tile
.equ CBUF   0x0200          ; int32 accumulator; requant overlays its low bytes
.equ SRQW   0x0300          ; requant word, staged once

.reg abuf   r1
.reg wbuf   r2
.reg cbuf   r3
.reg srqw   r4
.reg abase  r5              ; A DRAM base
.reg wbase  r6              ; W DRAM base
.reg cbase  r7              ; C DRAM base
.reg rqwd   r8             ; RQW DRAM base
.reg mt     r9
.reg nt     r10
.reg kt     r11
.reg mtiles r12
.reg ntiles r13
.reg klast  r14            ; KTILES - 1
.reg one    r15
.reg asm    r16            ; ASTRIDE_M
.reg wsn    r17            ; WSTRIDE_N
.reg atile  r18
.reg wtile  r19
.reg ctile  r20
.reg arow   r21            ; A base for the current mt row of tiles
.reg wcol   r22            ; W base for the current nt col of tiles
.reg ctil   r23            ; C tile address for (mt,nt)
.reg at     r24            ; current A tile address
.reg wt     r25            ; current W tile address
.reg tmp    r26

    ; ---- one-time config + constants ----
    setcfg  tlen,   T
    setcfg  scalar, SRQW        ; requant {m0,n} word lives at SRQW in scratchpad

    li  abuf,   ABUF
    li  wbuf,   WBUF
    li  cbuf,   CBUF
    li  srqw,   SRQW
    li  abase,  A
    li  wbase,  W
    li  cbase,  C
    li  rqwd,   RQW
    li  mtiles, MTILES
    li  ntiles, NTILES
    li  klast,  KTILES - 1
    li  one,    1
    li  asm,    ASTRIDE_M
    li  wsn,    WSTRIDE_N
    li  atile,  ATILE
    li  wtile,  WTILE
    li  ctile,  CTILE

    ; ---- stage the requant word once: DRAM -> scratch ----
    setcfg  len, 4
    rdmem   srqw, rqwd

    li  mt, 0
mloop:
    cmps    mt, mtiles
    bge     done
    muls    arow, mt, asm           ; arow = A + mt*ASTRIDE_M
    adds    arow, arow, abase
    li      nt, 0

nloop:
    cmps    nt, ntiles
    bge     mnext
    muls    wcol, nt, wsn           ; wcol = W + nt*WSTRIDE_N
    adds    wcol, wcol, wbase
    muls    ctil, mt, ntiles        ; ctil = C + (mt*NTILES + nt)*CTILE
    adds    ctil, ctil, nt
    muls    ctil, ctil, ctile
    adds    ctil, ctil, cbase

    ; ---- K tile 0: initialise the int32 accumulator (kt = 0, offset 0) ----
    setcfg  len, ATILE
    rdmem   abuf, arow
    setcfg  len, WTILE
    rdmem   wbuf, wcol
    matmul  cbuf, abuf, wbuf        ; C = A0 @ W0

    li      kt, 1
kloop:
    cmps    kt, klast               ; while kt < KTILES-1: accumulate middle tiles
    bge     klast_tile
    muls    at, kt, atile           ; at = arow + kt*ATILE
    adds    at, at, arow
    muls    wt, kt, wtile           ; wt = wcol + kt*WTILE
    adds    wt, wt, wcol
    setcfg  len, ATILE
    rdmem   abuf, at
    setcfg  len, WTILE
    rdmem   wbuf, wt
    matmul.acc  cbuf, abuf, wbuf    ; C += Ai @ Wi
    adds    kt, kt, one
    jmp     kloop

klast_tile:
    muls    at, kt, atile           ; last tile (kt = KTILES-1)
    adds    at, at, arow
    muls    wt, kt, wtile
    adds    wt, wt, wcol
    setcfg  len, ATILE
    rdmem   abuf, at
    setcfg  len, WTILE
    rdmem   wbuf, wt
    matmul.acc.rq  cbuf, abuf, wbuf ; C += last tile, then requant int32->int8

    ; ---- spill this T x COLS int8 output tile: scratch -> DRAM ----
    setcfg  len, CTILE
    wrmem   cbuf, ctil

    adds    nt, nt, one
    jmp     nloop

mnext:
    adds    mt, mt, one
    jmp     mloop

done:
    halt
