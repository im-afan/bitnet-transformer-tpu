; setcfgr.tpu — a config register written from a *register* rather than an
; immediate, checked by making the answer depend on it.
;
; `setcfg` takes an immediate, so every config value is frozen at assembly time.
; That is enough for prefill, where every shape is a compile-time constant, and
; not enough for incremental decode, where the number of attended keys grows by
; one per step and therefore has to be computed at run time
; (docs/macro_ops.md §9.2). `setcfgr cfgname, rN` is the missing move.
;
; The test has to make a *visible* difference, or it would pass against hardware
; that ignored the instruction. So `vlen` is computed rather than written
; directly: the program derives N = HALF*2 with scalar arithmetic and installs
; it, then adds N elements. If setcfgr were a no-op, `vlen` would keep whatever
; the previous `setcfg vlen, 1` left and only the first element would be summed
; — every other output byte would stay at its input value, which the golden
; vectors would catch immediately.
;
;     python ../assembler.py setcfgr.tpu --listing
;     python ../torch_ref.py -p setcfgr.tpu
;
; Self-contained over DRAM like the other examples: identical DRAM/scratchpad
; addresses, `rdmem` the operands in and `wrmem` the result out.

.equ A  0x0000      ; input vector A (int32)
.equ B  0x0400      ; input vector B (int32)
.equ C  0x0800      ; output C = A + B (int32)
.equ N  64          ; elements the program should end up processing
.equ HALF 32        ; N / 2 — the value the program starts from
.equ VEC_BYTES  256 ; N int32

.reg a  r1
.reg b  r2
.reg c  r3
.reg n  r4

    li      a, A
    li      b, B
    li      c, C

    setcfg  len, VEC_BYTES
    rdmem   a, a
    rdmem   b, b

    ; Poison vlen with an immediate first, so a setcfgr that did nothing would
    ; leave a length of 1 behind rather than accidentally the right answer.
    setcfg  vlen, 1

    ; N = HALF + HALF, computed in registers, then installed as the VPU length.
    li      n, HALF
    adds    n, n, n
    setcfgr vlen, n

    vecadd  c, a, b     ; C[i] = A[i] + B[i]  for i < N

    setcfg  len, VEC_BYTES
    wrmem   c, c
    halt
