; ============================================================================
; transformer_layer — generated by accel/tpulang/pytpu. Do not edit by hand;
; edit the composer or the primitive templates under pytpu/lib/ instead.
; one quantized transformer layer: T=8 d=32 f=64 heads=2 head_dim=16
; post-norm: Y = norm2(X1 + W2.gelu(W1.X1)), X1 = norm1(X + Wo.attn(X))
; ternary weights (MXU), int8 activations, VPU attention, LUT gelu/exp
; ============================================================================

; --------------------------------------------------------------------------
; [0] matmul_ternary  (qkv)  — [8,32] @ [32,96] ternary -> int8
; --------------------------------------------------------------------------
; @primitive matmul_ternary
; @clobbers r1-r30, cfg tlen/len/scalar
;
; C[M,N] int8 = requant(A[M,K] int8 @ W[K,N] ternary)   — the MXU workhorse.
;
; examples/tiled_matmul.tpu generalized: three nested tile loops (M, N, K) over
; an 8x8 array, with only the current tiles resident, so A, W and C may each be
; far larger than the scratchpad. The K flavours are the whole trick —
;
;     kt = 0        matmul          initialise the int32 partial
;     kt = 1..K-2   matmul.acc      C += this tile
;     kt = K-1      matmul.acc.rq   C += last tile, then requant int32 -> int8
;
; so the full contraction accumulates in int32 and exactly one requant happens,
; at the end. (KTILES >= 2 is therefore required: there must be a distinct init
; tile and a distinct requant tile. primitives.py asserts it.)
;
; **Layout: A and C are plain row-major [M,K] / [M,N].** The MXU wants an
; activation tile as T rows of ROWS *contiguous* bytes, which a row-major matrix
; is not, so the A tile is gathered one row at a time (T DMA fills of ROWS bytes
; at DRAM stride K) and the C tile is scattered back the same way. That costs two
; short loops and buys the thing that matters for composition: every activation
; in the generated program is plain row-major, so the VPU primitives — which have
; no notion of tiles — can consume any matmul's output directly.
;
; W is the exception: it is a *weight*, packed offline by quant.pack_ternary into
; the tile-major [nt][kt] order this loop walks, 2 bits per trit, column-major
; within a tile. It is read with one contiguous DMA per tile.
;
; Scratchpad footprint is fixed at T*8 + 16 + T*8*4 bytes regardless of M, K, N.
;
; @param A     DRAM byte address of A[M,K], int8, row-major
; @param W     DRAM byte address of W[K,N], ternary, tile-major [nt][kt] packed
; @param C     DRAM byte address of C[M,N], int8, row-major (output)
; @param RQW   address of the requant {m0,n} word (int32; DRAM == scratchpad)
; @param M     rows of A / C          (multiple of TT)
; @param K     contraction length     (multiple of 8, KTILES >= 2)
; @param N     columns of W / C       (multiple of 8)
; @param ABUF  scratchpad buffer for one A tile      (TT*8 bytes)
; @param WBUF  scratchpad buffer for one W tile      (16 bytes)
; @param CBUF  scratchpad int32 accumulator          (TT*8*4 bytes)
; @default TT  8

; ---- array / problem geometry ------------------------------------------------
.equ qkv_ROWS   8                          ; MXU contraction dim (K per tile)
.equ qkv_COLS   8                          ; MXU output features (N per tile)
.equ qkv_T      8                     ; tokens per matmul pass (cfg tlen)
.equ qkv_MTILES 8 // 8
.equ qkv_KTILES 32 // qkv_ROWS
.equ qkv_NTILES 96 // qkv_COLS
.equ qkv_WTILE  qkv_COLS * ((qkv_ROWS * 2) // 8) ; packed ternary bytes per tile (= 16)

.reg qkv_abuf   r1
.reg qkv_wbuf   r2
.reg qkv_cbuf   r3
.reg qkv_rqw    r4
.reg qkv_abase  r5
.reg qkv_wbase  r6
.reg qkv_cbase  r7
.reg qkv_mt     r8
.reg qkv_nt     r9
.reg qkv_kt     r10
.reg qkv_mtiles r11
.reg qkv_ntiles r12
.reg qkv_ktiles r13
.reg qkv_klast  r14
.reg qkv_one    r15
.reg qkv_eight  r16
.reg qkv_tt     r17            ; row counter for the gather / scatter loops
.reg qkv_trows  r18            ; T
.reg qkv_kdim   r19            ; K  (row stride of A)
.reg qkv_ndim   r20            ; N  (row stride of C)
.reg qkv_wtile  r21
.reg qkv_arow   r22            ; A + mt*T*K      — top-left of this M block
.reg qkv_crow   r23            ; C + mt*T*N
.reg qkv_wcol   r24            ; W + nt*KTILES*WTILE
.reg qkv_ctil   r25            ; crow + nt*COLS  — top-left of this C tile
.reg qkv_at     r26            ; arow + kt*ROWS  — top-left of this A tile
.reg qkv_wt     r27
.reg qkv_s      r28            ; scratch/DRAM source cursor
.reg qkv_d      r29            ; scratch/DRAM destination cursor

    setcfg  tlen,   qkv_T
    setcfg  scalar, 0x2080     ; MXU reads {m0,n} from this scratchpad address

    li  qkv_abuf,   0x5000
    li  qkv_wbuf,   0x5040
    li  qkv_cbuf,   0x5050
    li  qkv_rqw,    0x2080
    li  qkv_abase,  0x0000
    li  qkv_wbase,  0x0100
    li  qkv_cbase,  0x0a00
    li  qkv_mtiles, qkv_MTILES
    li  qkv_ntiles, qkv_NTILES
    li  qkv_ktiles, qkv_KTILES
    li  qkv_klast,  qkv_KTILES - 1
    li  qkv_one,    1
    li  qkv_eight,  qkv_ROWS
    li  qkv_trows,  qkv_T
    li  qkv_kdim,   32
    li  qkv_ndim,   96
    li  qkv_wtile,  qkv_WTILE

    ; ---- stage the requant word once (identical DRAM/scratchpad address) ----
    setcfg  len, 4
    rdmem   qkv_rqw, qkv_rqw

    li  qkv_mt, 0
qkv_mloop:
    cmps    qkv_mt, qkv_mtiles
    bge     qkv_mdone
    muls    qkv_arow, qkv_mt, qkv_trows
    muls    qkv_arow, qkv_arow, qkv_kdim
    adds    qkv_arow, qkv_arow, qkv_abase        ; arow = A + mt*T*K
    muls    qkv_crow, qkv_mt, qkv_trows
    muls    qkv_crow, qkv_crow, qkv_ndim
    adds    qkv_crow, qkv_crow, qkv_cbase        ; crow = C + mt*T*N
    li      qkv_nt, 0

qkv_nloop:
    cmps    qkv_nt, qkv_ntiles
    bge     qkv_ndone
    muls    qkv_wcol, qkv_nt, qkv_ktiles
    muls    qkv_wcol, qkv_wcol, qkv_wtile
    adds    qkv_wcol, qkv_wcol, qkv_wbase        ; wcol = W + nt*KTILES*WTILE
    muls    qkv_ctil, qkv_nt, qkv_eight
    adds    qkv_ctil, qkv_ctil, qkv_crow         ; ctil = crow + nt*COLS
    li      qkv_kt, 0

qkv_kloop:
    ; ---- gather one A tile: T rows of ROWS bytes, DRAM row stride K ----
    muls    qkv_at, qkv_kt, qkv_eight
    adds    qkv_at, qkv_at, qkv_arow
    setcfg  len, qkv_ROWS
    li      qkv_tt, 0
qkv_aloop:
    cmps    qkv_tt, qkv_trows
    bge     qkv_adone
    muls    qkv_s, qkv_tt, qkv_kdim
    adds    qkv_s, qkv_s, qkv_at                 ; DRAM    A + (mt*T+tt)*K + kt*ROWS
    muls    qkv_d, qkv_tt, qkv_eight
    adds    qkv_d, qkv_d, qkv_abuf               ; scratch ABUF + tt*ROWS
    rdmem   qkv_d, qkv_s
    adds    qkv_tt, qkv_tt, qkv_one
    jmp     qkv_aloop
qkv_adone:

    ; ---- one W tile: contiguous, already in the layout the MXU wants ----
    muls    qkv_wt, qkv_kt, qkv_wtile
    adds    qkv_wt, qkv_wt, qkv_wcol
    setcfg  len, qkv_WTILE
    rdmem   qkv_wbuf, qkv_wt

    ; ---- the matmul flavour depends on where this tile sits in K ----
    cmps    qkv_kt, r0
    bne     qkv_knotfirst
    matmul  qkv_cbuf, qkv_abuf, qkv_wbuf             ; kt = 0: initialise the accumulator
    jmp     qkv_knext
qkv_knotfirst:
    cmps    qkv_kt, qkv_klast
    bne     qkv_kmiddle
    matmul.acc.rq  qkv_cbuf, qkv_abuf, qkv_wbuf      ; kt = K-1: accumulate, then requant
    jmp     qkv_knext
qkv_kmiddle:
    matmul.acc     qkv_cbuf, qkv_abuf, qkv_wbuf      ; middle: accumulate in int32
qkv_knext:
    adds    qkv_kt, qkv_kt, qkv_one
    cmps    qkv_kt, qkv_ktiles
    blt     qkv_kloop

    ; ---- scatter the T x COLS int8 tile back into row-major C ----
    ; The .rq store wrote int8 at cbuf + t*COLS, overlaying the accumulator's
    ; low bytes, so the scratch row stride here is COLS, not COLS*4.
    setcfg  len, qkv_COLS
    li      qkv_tt, 0
qkv_cloop:
    cmps    qkv_tt, qkv_trows
    bge     qkv_cdone
    muls    qkv_s, qkv_tt, qkv_eight
    adds    qkv_s, qkv_s, qkv_cbuf               ; scratch CBUF + tt*COLS
    muls    qkv_d, qkv_tt, qkv_ndim
    adds    qkv_d, qkv_d, qkv_ctil               ; DRAM    C + (mt*T+tt)*N + nt*COLS
    wrmem   qkv_s, qkv_d
    adds    qkv_tt, qkv_tt, qkv_one
    jmp     qkv_cloop
qkv_cdone:

    adds    qkv_nt, qkv_nt, qkv_one
    jmp     qkv_nloop
qkv_ndone:
    adds    qkv_mt, qkv_mt, qkv_one
    jmp     qkv_mloop
qkv_mdone:

; --------------------------------------------------------------------------
; [1] matmul_i8  (scores)  — S = Q K^T per head, over the head dim
; --------------------------------------------------------------------------
; @primitive matmul_i8
; @clobbers r1-r24, cfg vlen/len
;
; O[h,m,n] int32 = sum_k A[h,m,k] * B[h,n,k]     — a batched int8 x int8 matmul
; on the VPU, one `vecdot` per (h, m, n) with vlen = KLEN.
;
; The MXU multiplies int8 activations by *ternary* weights, which is the wrong
; shape for attention: in prefill both operands are int8 activations and neither
; is a stored weight. So attention's two matmuls run here instead. `vecdot`
; contracts two int8 vectors into one int32 scalar, so B is consumed as B^T
; without ever being transposed — the inner loop walks B's rows.
;
; Every axis is addressed by an explicit byte stride, which is what lets one
; template serve both attention matmuls even though their operands are strided
; sub-blocks of larger tensors:
;
;     element        address
;     A[h,m,k]       A + h*AH + m*AM + k
;     B[h,n,k]       B + h*BH + n*BN + k
;     O[h,m,n]       O + h*OH + m*OM + n*4      (int32)
;
;   S = Q K^T   A=Q slice of QKV, AH=head_dim, AM=3*d;  B=K slice, BH=head_dim,
;               BN=3*d;  KLEN=head_dim;  O=S32, OH=T*T*4, OM=T*4
;   A = P V^T   A=P, AH=T*T, AM=T;  B=V^T, BH=head_dim*T, BN=T;  KLEN=T;
;               O=AO32, OH=head_dim*4, OM=d*4
;
; Note the first one: a head's slice of Q is *not* contiguous, but each
; (head, token) row is head_dim contiguous bytes, which is all `vecdot` needs.
; So heads never have to be un-interleaved out of the [T, 3d] layout the MXU
; produced. The head loop is inside this template, so head count costs no
; instructions.
;
; Staging is explicit: two DRAM->scratchpad fills (the second may be 0 bytes),
; then the whole O span is spilled back. O must therefore be a dense O_BYTES
; region — the strides may not leave gaps inside it.
;
; @param IN0        DRAM address of the first region to stage in
; @param IN0_BYTES  bytes to fill from IN0
; @param IN1        DRAM address of the second region (may equal IN0)
; @param IN1_BYTES  bytes to fill from IN1 (0 = no second fill)
; @param A          base address of A
; @param AH         byte stride of A's head axis
; @param AM         byte stride of A's row axis
; @param B          base address of B
; @param BH         byte stride of B's head axis
; @param BN         byte stride of B's row axis
; @param O          base address of O (int32)
; @param OH         byte stride of O's head axis
; @param OM         byte stride of O's row axis
; @param O_BYTES    dense byte span of O, spilled to DRAM at the end
; @param H          heads (batch axis)
; @param M          rows of A per head
; @param N          rows of B per head
; @param KLEN       contraction length in elements (= cfg vlen)

.reg scores_s0     r1
.reg scores_s1     r2
.reg scores_a      r3
.reg scores_b      r4
.reg scores_o      r5
.reg scores_h      r6
.reg scores_m      r7
.reg scores_n      r8
.reg scores_hh     r9
.reg scores_mm     r10
.reg scores_nn     r11
.reg scores_one    r12
.reg scores_four   r13
.reg scores_ahs    r14
.reg scores_ams    r15
.reg scores_bhs    r16
.reg scores_bns    r17
.reg scores_ohs    r18
.reg scores_oms    r19
.reg scores_ab     r20            ; A + h*AH
.reg scores_bb     r21            ; B + h*BH
.reg scores_ob     r22            ; O + h*OH
.reg scores_am     r23            ; &A[h,m,0]
.reg scores_om     r24            ; &O[h,m,0]
.reg scores_bn     r25            ; &B[h,n,0]
.reg scores_dst    r26            ; &O[h,m,n]

    ; ---- stage operands: DRAM -> scratchpad (identical addresses) ----
    li      scores_s0, 0x0a00
    setcfg  len, 768
    rdmem   scores_s0, scores_s0
    li      scores_s1, 0x0a00
    setcfg  len, 0
    rdmem   scores_s1, scores_s1

    li      scores_a,    0x0a00
    li      scores_b,    0x0a20
    li      scores_o,    0x0d00
    li      scores_hh,   2
    li      scores_mm,   8
    li      scores_nn,   8
    li      scores_one,  1
    li      scores_four, 4
    li      scores_ahs,  16
    li      scores_ams,  96
    li      scores_bhs,  16
    li      scores_bns,  96
    li      scores_ohs,  256
    li      scores_oms,  32

    setcfg  vlen, 16          ; every vecdot contracts over KLEN elements
    li      scores_h, 0
scores_hloop:
    cmps    scores_h, scores_hh
    bge     scores_hdone
    muls    scores_ab, scores_h, scores_ahs
    adds    scores_ab, scores_ab, scores_a
    muls    scores_bb, scores_h, scores_bhs
    adds    scores_bb, scores_bb, scores_b
    muls    scores_ob, scores_h, scores_ohs
    adds    scores_ob, scores_ob, scores_o
    li      scores_m, 0

scores_mloop:
    cmps    scores_m, scores_mm
    bge     scores_mdone
    muls    scores_am, scores_m, scores_ams
    adds    scores_am, scores_am, scores_ab               ; &A[h,m,0]
    muls    scores_om, scores_m, scores_oms
    adds    scores_om, scores_om, scores_ob               ; &O[h,m,0]
    li      scores_n, 0

scores_nloop:
    cmps    scores_n, scores_nn
    bge     scores_ndone
    muls    scores_bn, scores_n, scores_bns
    adds    scores_bn, scores_bn, scores_bb               ; &B[h,n,0]
    muls    scores_dst, scores_n, scores_four
    adds    scores_dst, scores_dst, scores_om             ; &O[h,m,n]  (int32 lane)
    vecdot  scores_dst, scores_am, scores_bn
    adds    scores_n, scores_n, scores_one
    jmp     scores_nloop

scores_ndone:
    adds    scores_m, scores_m, scores_one
    jmp     scores_mloop
scores_mdone:
    adds    scores_h, scores_h, scores_one
    jmp     scores_hloop
scores_hdone:
    ; ---- spill the whole int32 result block: scratchpad -> DRAM ----
    setcfg  len, 512
    wrmem   scores_o, scores_o

; --------------------------------------------------------------------------
; [2] requant_block  (scores_rq)  — 128 elements int32 -> int8
; --------------------------------------------------------------------------
; @primitive requant_block
; @clobbers r1-r11, cfg vlen/len
;
; dst[N] int8 = clip_int8((src[N] int32 * m0 + (1 << (n-1))) >> n)
;
; The narrowing half of the VPU's type discipline. Compute ops read int8 and
; write int32; `requant` is the *only* op that goes back the other way, so every
; int32 buffer that a later VPU op will consume passes through here. It is also
; where a producer's scale is turned into the consumer's: the {m0,n} word is
; chosen at compile time by quant.choose_requant from the two tensors' scales.
;
; Walks the block in chunks of CHUNK elements because cfg `vlen` is 10 bits
; (<= 1023). N must be a whole number of chunks; primitives.py picks CHUNK.
;
; @param SRC    DRAM address of src[N], int32 (stride 4)
; @param DST    DRAM address of dst[N], int8  (stride 1)
; @param RQW    address of the requant {m0,n} word (DRAM == scratchpad)
; @param N      elements
; @param CHUNK  elements per pass (<= 1023, divides N)

.equ scores_rq_NCHUNK 128 // 128
.equ scores_rq_CH4    128 * 4

.reg scores_rq_src   r1
.reg scores_rq_dst   r2
.reg scores_rq_rqw   r3
.reg scores_rq_nch   r4
.reg scores_rq_one   r5
.reg scores_rq_ch4   r6
.reg scores_rq_ch1   r7
.reg scores_rq_i     r8
.reg scores_rq_so    r9
.reg scores_rq_do    r10

    li      scores_rq_src, 0x0d00
    li      scores_rq_dst, 0x0f00
    li      scores_rq_rqw, 0x2084
    setcfg  len, 4
    rdmem   scores_rq_rqw, scores_rq_rqw              ; stage {m0,n} (identical DRAM/scratch addr)

    setcfg  vlen, 128
    li      scores_rq_nch, scores_rq_NCHUNK
    li      scores_rq_one, 1
    li      scores_rq_ch4, scores_rq_CH4
    li      scores_rq_ch1, 128
    li      scores_rq_i, 0
scores_rq_loop:
    cmps    scores_rq_i, scores_rq_nch
    bge     scores_rq_done
    muls    scores_rq_so, scores_rq_i, scores_rq_ch4
    adds    scores_rq_so, scores_rq_so, scores_rq_src          ; &src[i*CHUNK]  (int32 stride)
    muls    scores_rq_do, scores_rq_i, scores_rq_ch1
    adds    scores_rq_do, scores_rq_do, scores_rq_dst          ; &dst[i*CHUNK]  (int8 stride)
    setcfg  len, scores_rq_CH4
    rdmem   scores_rq_so, scores_rq_so
    requant scores_rq_do, scores_rq_so, scores_rq_rqw
    setcfg  len, 128
    wrmem   scores_rq_do, scores_rq_do
    adds    scores_rq_i, scores_rq_i, scores_rq_one
    jmp     scores_rq_loop
scores_rq_done:

; --------------------------------------------------------------------------
; [3] add_i8  (mask)  — causal mask: +(-128) drives a key to exp's zero
; --------------------------------------------------------------------------
; @primitive add_i8
; @clobbers r1-r13, cfg vlen/len
;
; C[N] int8 = requant(A[N] int8 + B[N] int8)
;
; `vecadd` widens int8 + int8 -> int32 (that widening is the point — a residual
; sum overflows int8 routinely), so the requant back to int8 is not decoration,
; it is what makes the result consumable by the next VPU op. With A and B in the
; same scale the {m0,n} word is the identity {1,0} and the requant is a plain
; int8 clip.
;
; Two jobs in the transformer layer, and they are the same op:
;   * the two **residual adds**;
;   * the **causal attention mask** — a mask is an int8 tensor of 0 and -128, and
;     adding -128 drives an entry to the clip floor, which in the exp table's
;     1/16 input scale is x = -8, where the table stores 0. So masking is data,
;     not an instruction.
;
; @param A      DRAM address of A[N], int8
; @param B      DRAM address of B[N], int8
; @param C      DRAM address of C[N], int8 (output; may alias A or B)
; @param RQW    address of the requant {m0,n} word (DRAM == scratchpad)
; @param TMP    scratchpad int32 buffer, CHUNK*4 bytes
; @param N      elements
; @param CHUNK  elements per pass (<= 1023, divides N)

.equ mask_NCHUNK 128 // 128

.reg mask_a     r1
.reg mask_b     r2
.reg mask_c     r3
.reg mask_rqw   r4
.reg mask_tmp   r5
.reg mask_nch   r6
.reg mask_one   r7
.reg mask_ch    r8
.reg mask_i     r9
.reg mask_off   r10
.reg mask_ao    r11
.reg mask_bo    r12
.reg mask_co    r13

    li      mask_a,   0x0f00
    li      mask_b,   0x0980
    li      mask_c,   0x0f80
    li      mask_rqw, 0x2088
    setcfg  len, 4
    rdmem   mask_rqw, mask_rqw

    li      mask_tmp, 0x5150
    setcfg  vlen, 128
    li      mask_nch, mask_NCHUNK
    li      mask_one, 1
    li      mask_ch,  128
    li      mask_i, 0
mask_loop:
    cmps    mask_i, mask_nch
    bge     mask_done
    muls    mask_off, mask_i, mask_ch
    adds    mask_ao, mask_off, mask_a
    adds    mask_bo, mask_off, mask_b
    adds    mask_co, mask_off, mask_c
    setcfg  len, 128
    rdmem   mask_ao, mask_ao
    rdmem   mask_bo, mask_bo
    vecadd  mask_tmp, mask_ao, mask_bo         ; int8 + int8 -> int32
    requant mask_co, mask_tmp, mask_rqw        ; int32 -> int8
    wrmem   mask_co, mask_co
    adds    mask_i, mask_i, mask_one
    jmp     mask_loop
mask_done:

; --------------------------------------------------------------------------
; [4] softmax_rows  (softmax)  — 16 rows of 8
; --------------------------------------------------------------------------
; @primitive softmax_rows
; @clobbers r1-r21, cfg vlen/len
;
; P[R,L] int8 (scale 1/128) = softmax(S[R,L] int8, rows)
;
; The ISA has no softmax instruction; the scalar unit decomposes it into VPU
; primitives. This is that sequence made **type-correct**, which is the part
; examples/softmax_row.tpu gets wrong (see torch_ref.UNSUPPORTED) — VPU ops read
; int8 and write int32, so every `requant` below exists because the *next* op
; reads int8. None of them is decoration.
;
;     redmax  m       <- row              int32 scalar, into the scratchpad
;     loads/subs/stores                   -m, staged back as a broadcast scalar
;     sadd    sh32    <- row, -m          int32:  x_i - max  (<= 0)
;     requant sh8     <- sh32   {1,0}     int8; the clip floor -128 is x = -8
;     exp     e32     <- sh8              int32 in the table's 1/127 out_scale
;     requant e8      <- e32    {1,0}     int8
;     redsum  D       <- e8               int32 scalar
;     sdiv    p32     <- e8, D            int32 Q15: round(e_i * 2^15 / D)
;     requant P       <- p32    {1,8}     int8: >>8 puts probabilities on 1/128
;
; **Preconditions**, both the composer's job (getting into a table's input scale
; is always the compiler's job, never the hardware's — luts.py):
;   * SRC is already in the exp table's **1/16** input scale, and
;   * SRC is already masked (add_i8 with an int8 mask of 0 / -128).
;
; The max-subtract is what makes the table's negative half the only half that is
; reached: exp's positive indices all saturate at 127 and a program that reaches
; them has forgotten the subtract. Here row_max maps to exactly 0, where the
; table stores +127, so D >= 127 > 0 and the divide can never see a zero.
;
; The two {m0,n} words are compile-time constants, so they are built in-program
; with `li`/`stores` rather than shipped in DRAM.
;
; @param SRC   DRAM address of S[R,L], int8, at scale 1/16, masked
; @param DST   DRAM address of P[R,L], int8, at scale 1/128
; @param R     rows
; @param L     row length (= cfg vlen)
; @param MAXA  scratchpad int32 word: the row max
; @param NEGA  scratchpad int32 word: -max, the broadcast scalar
; @param SH32  scratchpad int32 buffer, L*4 bytes
; @param SH8   scratchpad int8  buffer, L bytes
; @param E32   scratchpad int32 buffer, L*4 bytes
; @param E8    scratchpad int8  buffer, L bytes
; @param DEN   scratchpad int32 word: the denominator
; @param P32   scratchpad int32 buffer, L*4 bytes
; @param RQ1   scratchpad int32 word: holds {m0=1, n=0}, built below
; @param RQ2   scratchpad int32 word: holds {m0=1, n=8}, built below

.equ softmax_BYTES 16 * 8
.equ softmax_M0_W  12                  ; requant word layout: m0 low, n above (isa.md)

.reg softmax_src    r1
.reg softmax_dst    r2
.reg softmax_maxa   r3
.reg softmax_nega   r4
.reg softmax_sh32   r5
.reg softmax_sh8    r6
.reg softmax_e32    r7
.reg softmax_e8     r8
.reg softmax_den    r9
.reg softmax_p32    r10
.reg softmax_rq1    r11
.reg softmax_rq2    r12
.reg softmax_rows   r13
.reg softmax_ll     r14
.reg softmax_one    r15
.reg softmax_r      r16
.reg softmax_rowsrc r17
.reg softmax_rowdst r18
.reg softmax_t      r19
.reg softmax_u      r20
.reg softmax_v      r21

    ; ---- build the two constant requant words in the scratchpad ----
    li      softmax_one, 1
    li      softmax_rq1, 0x53cc
    stores  softmax_rq1, softmax_one              ; {m0 = 1, n = 0} — a plain int8 clip
    li      softmax_rq2, 0x53d0
    li      softmax_u, 1 << softmax_M0_W          ; = 4096, the n field's weight
    li      softmax_v, 8
    muls    softmax_v, softmax_v, softmax_u
    adds    softmax_v, softmax_v, softmax_one
    stores  softmax_rq2, softmax_v                ; {m0 = 1, n = 8} — Q15 -> scale 1/128

    ; ---- stage the whole score block: DRAM -> scratchpad ----
    li      softmax_src, 0x0f80
    li      softmax_dst, 0x1000
    setcfg  len, softmax_BYTES
    rdmem   softmax_src, softmax_src

    li      softmax_maxa, 0x5350
    li      softmax_nega, 0x5354
    li      softmax_sh32, 0x535c
    li      softmax_sh8,  0x537c
    li      softmax_e32,  0x5384
    li      softmax_e8,   0x53a4
    li      softmax_den,  0x5358
    li      softmax_p32,  0x53ac
    li      softmax_rows, 16
    li      softmax_ll,   8

    setcfg  vlen, 8             ; every op below walks one row
    li      softmax_r, 0
softmax_rloop:
    cmps    softmax_r, softmax_rows
    bge     softmax_rdone
    muls    softmax_rowsrc, softmax_r, softmax_ll
    adds    softmax_rowsrc, softmax_rowsrc, softmax_src
    muls    softmax_rowdst, softmax_r, softmax_ll
    adds    softmax_rowdst, softmax_rowdst, softmax_dst

    redmax  softmax_maxa, softmax_rowsrc          ; m = max_i x_i           -> scratchpad
    loads   softmax_t, softmax_maxa               ; ...bring it back as a scalar
    subs    softmax_t, r0, softmax_t
    stores  softmax_nega, softmax_t               ; -m, now broadcastable
    sadd    softmax_sh32, softmax_rowsrc, softmax_nega   ; x_i - m  (int32, <= 0)
    requant softmax_sh8, softmax_sh32, softmax_rq1       ; int8; clips at -128 == x = -8
    exp     softmax_e32, softmax_sh8              ; exp table (int32 out)
    requant softmax_e8, softmax_e32, softmax_rq1         ; int8, so redsum/sdiv can read it
    redsum  softmax_den, softmax_e8               ; D = sum_i e_i           -> scratchpad
    sdiv    softmax_p32, softmax_e8, softmax_den         ; Q15 probabilities (int32)
    requant softmax_rowdst, softmax_p32, softmax_rq2     ; int8 at scale 1/128

    adds    softmax_r, softmax_r, softmax_one
    jmp     softmax_rloop
softmax_rdone:
    ; ---- spill the probabilities: scratchpad -> DRAM ----
    setcfg  len, softmax_BYTES
    wrmem   softmax_dst, softmax_dst

; --------------------------------------------------------------------------
; [5] transpose_i8  (vt)  — [8,32] -> [32,8] int8
; --------------------------------------------------------------------------
; @primitive transpose_i8
; @clobbers r1-r12, cfg len
;
; B[n,m] = A[m,n], int8, in DRAM.
;
; Why this has to exist: `vecdot` requires both operands contiguous along the
; contraction axis, and for attention's second matmul (P @ V) the contraction is
; over *keys*, so V must be key-contiguous — i.e. V^T. The ISA has no transpose
; and no strided vector load, so the bytes have to move.
;
; The trick is that **a DMA with len = 1 is a byte move between two arbitrary
; addresses**. This loops over elements doing rdmem (1 byte, DRAM -> a single
; scratchpad cell) then wrmem (that cell -> the transposed DRAM address). M*N
; iterations of a 7-instruction body: slow in cycles, tiny in instructions, and
; correct. Replace it the day a transposing DMA mode lands.
;
; Both sides take an explicit row stride, so the source may be a sub-block of a
; larger tensor (V is columns 2d..3d of the fused QKV matrix).
;
; @param SRC         DRAM address of A[M,N] int8
; @param DST         DRAM address of B[N,M] int8
; @param M           rows of A
; @param N           columns of A
; @param SRC_STRIDE  byte stride between rows of A (>= N)
; @param DST_STRIDE  byte stride between rows of B (>= M)
; @param BUF         a 1-byte scratchpad cell used as the staging point

.reg vt_src   r1
.reg vt_dst   r2
.reg vt_mm    r3
.reg vt_nn    r4
.reg vt_ss    r5
.reg vt_ds    r6
.reg vt_buf   r7
.reg vt_one   r8
.reg vt_m     r9
.reg vt_n     r10
.reg vt_s     r11
.reg vt_d     r12

    li      vt_src, 0x0a40
    li      vt_dst, 0x1080
    li      vt_mm,  8
    li      vt_nn,  32
    li      vt_ss,  96
    li      vt_ds,  8
    li      vt_buf, 0x53d4
    li      vt_one, 1
    setcfg  len, 1              ; one byte per DMA — this is the whole mechanism

    li      vt_m, 0
vt_mloop:
    cmps    vt_m, vt_mm
    bge     vt_mdone
    li      vt_n, 0
vt_nloop:
    cmps    vt_n, vt_nn
    bge     vt_ndone
    muls    vt_s, vt_m, vt_ss
    adds    vt_s, vt_s, vt_n
    adds    vt_s, vt_s, vt_src            ; &A[m,n]
    muls    vt_d, vt_n, vt_ds
    adds    vt_d, vt_d, vt_m
    adds    vt_d, vt_d, vt_dst            ; &B[n,m]
    rdmem   vt_buf, vt_s                ; DRAM -> scratchpad cell
    wrmem   vt_buf, vt_d                ; scratchpad cell -> DRAM
    adds    vt_n, vt_n, vt_one
    jmp     vt_nloop
vt_ndone:
    adds    vt_m, vt_m, vt_one
    jmp     vt_mloop
vt_mdone:

; --------------------------------------------------------------------------
; [6] matmul_i8  (attn)  — AO = P V^T per head, over the key axis
; --------------------------------------------------------------------------
; @primitive matmul_i8
; @clobbers r1-r24, cfg vlen/len
;
; O[h,m,n] int32 = sum_k A[h,m,k] * B[h,n,k]     — a batched int8 x int8 matmul
; on the VPU, one `vecdot` per (h, m, n) with vlen = KLEN.
;
; The MXU multiplies int8 activations by *ternary* weights, which is the wrong
; shape for attention: in prefill both operands are int8 activations and neither
; is a stored weight. So attention's two matmuls run here instead. `vecdot`
; contracts two int8 vectors into one int32 scalar, so B is consumed as B^T
; without ever being transposed — the inner loop walks B's rows.
;
; Every axis is addressed by an explicit byte stride, which is what lets one
; template serve both attention matmuls even though their operands are strided
; sub-blocks of larger tensors:
;
;     element        address
;     A[h,m,k]       A + h*AH + m*AM + k
;     B[h,n,k]       B + h*BH + n*BN + k
;     O[h,m,n]       O + h*OH + m*OM + n*4      (int32)
;
;   S = Q K^T   A=Q slice of QKV, AH=head_dim, AM=3*d;  B=K slice, BH=head_dim,
;               BN=3*d;  KLEN=head_dim;  O=S32, OH=T*T*4, OM=T*4
;   A = P V^T   A=P, AH=T*T, AM=T;  B=V^T, BH=head_dim*T, BN=T;  KLEN=T;
;               O=AO32, OH=head_dim*4, OM=d*4
;
; Note the first one: a head's slice of Q is *not* contiguous, but each
; (head, token) row is head_dim contiguous bytes, which is all `vecdot` needs.
; So heads never have to be un-interleaved out of the [T, 3d] layout the MXU
; produced. The head loop is inside this template, so head count costs no
; instructions.
;
; Staging is explicit: two DRAM->scratchpad fills (the second may be 0 bytes),
; then the whole O span is spilled back. O must therefore be a dense O_BYTES
; region — the strides may not leave gaps inside it.
;
; @param IN0        DRAM address of the first region to stage in
; @param IN0_BYTES  bytes to fill from IN0
; @param IN1        DRAM address of the second region (may equal IN0)
; @param IN1_BYTES  bytes to fill from IN1 (0 = no second fill)
; @param A          base address of A
; @param AH         byte stride of A's head axis
; @param AM         byte stride of A's row axis
; @param B          base address of B
; @param BH         byte stride of B's head axis
; @param BN         byte stride of B's row axis
; @param O          base address of O (int32)
; @param OH         byte stride of O's head axis
; @param OM         byte stride of O's row axis
; @param O_BYTES    dense byte span of O, spilled to DRAM at the end
; @param H          heads (batch axis)
; @param M          rows of A per head
; @param N          rows of B per head
; @param KLEN       contraction length in elements (= cfg vlen)

.reg attn_s0     r1
.reg attn_s1     r2
.reg attn_a      r3
.reg attn_b      r4
.reg attn_o      r5
.reg attn_h      r6
.reg attn_m      r7
.reg attn_n      r8
.reg attn_hh     r9
.reg attn_mm     r10
.reg attn_nn     r11
.reg attn_one    r12
.reg attn_four   r13
.reg attn_ahs    r14
.reg attn_ams    r15
.reg attn_bhs    r16
.reg attn_bns    r17
.reg attn_ohs    r18
.reg attn_oms    r19
.reg attn_ab     r20            ; A + h*AH
.reg attn_bb     r21            ; B + h*BH
.reg attn_ob     r22            ; O + h*OH
.reg attn_am     r23            ; &A[h,m,0]
.reg attn_om     r24            ; &O[h,m,0]
.reg attn_bn     r25            ; &B[h,n,0]
.reg attn_dst    r26            ; &O[h,m,n]

    ; ---- stage operands: DRAM -> scratchpad (identical addresses) ----
    li      attn_s0, 0x1000
    setcfg  len, 128
    rdmem   attn_s0, attn_s0
    li      attn_s1, 0x1080
    setcfg  len, 256
    rdmem   attn_s1, attn_s1

    li      attn_a,    0x1000
    li      attn_b,    0x1080
    li      attn_o,    0x1180
    li      attn_hh,   2
    li      attn_mm,   8
    li      attn_nn,   16
    li      attn_one,  1
    li      attn_four, 4
    li      attn_ahs,  64
    li      attn_ams,  8
    li      attn_bhs,  128
    li      attn_bns,  8
    li      attn_ohs,  64
    li      attn_oms,  128

    setcfg  vlen, 8          ; every vecdot contracts over KLEN elements
    li      attn_h, 0
attn_hloop:
    cmps    attn_h, attn_hh
    bge     attn_hdone
    muls    attn_ab, attn_h, attn_ahs
    adds    attn_ab, attn_ab, attn_a
    muls    attn_bb, attn_h, attn_bhs
    adds    attn_bb, attn_bb, attn_b
    muls    attn_ob, attn_h, attn_ohs
    adds    attn_ob, attn_ob, attn_o
    li      attn_m, 0

attn_mloop:
    cmps    attn_m, attn_mm
    bge     attn_mdone
    muls    attn_am, attn_m, attn_ams
    adds    attn_am, attn_am, attn_ab               ; &A[h,m,0]
    muls    attn_om, attn_m, attn_oms
    adds    attn_om, attn_om, attn_ob               ; &O[h,m,0]
    li      attn_n, 0

attn_nloop:
    cmps    attn_n, attn_nn
    bge     attn_ndone
    muls    attn_bn, attn_n, attn_bns
    adds    attn_bn, attn_bn, attn_bb               ; &B[h,n,0]
    muls    attn_dst, attn_n, attn_four
    adds    attn_dst, attn_dst, attn_om             ; &O[h,m,n]  (int32 lane)
    vecdot  attn_dst, attn_am, attn_bn
    adds    attn_n, attn_n, attn_one
    jmp     attn_nloop

attn_ndone:
    adds    attn_m, attn_m, attn_one
    jmp     attn_mloop
attn_mdone:
    adds    attn_h, attn_h, attn_one
    jmp     attn_hloop
attn_hdone:
    ; ---- spill the whole int32 result block: scratchpad -> DRAM ----
    setcfg  len, 1024
    wrmem   attn_o, attn_o

; --------------------------------------------------------------------------
; [7] requant_block  (attn_rq)  — 256 elements int32 -> int8
; --------------------------------------------------------------------------
; @primitive requant_block
; @clobbers r1-r11, cfg vlen/len
;
; dst[N] int8 = clip_int8((src[N] int32 * m0 + (1 << (n-1))) >> n)
;
; The narrowing half of the VPU's type discipline. Compute ops read int8 and
; write int32; `requant` is the *only* op that goes back the other way, so every
; int32 buffer that a later VPU op will consume passes through here. It is also
; where a producer's scale is turned into the consumer's: the {m0,n} word is
; chosen at compile time by quant.choose_requant from the two tensors' scales.
;
; Walks the block in chunks of CHUNK elements because cfg `vlen` is 10 bits
; (<= 1023). N must be a whole number of chunks; primitives.py picks CHUNK.
;
; @param SRC    DRAM address of src[N], int32 (stride 4)
; @param DST    DRAM address of dst[N], int8  (stride 1)
; @param RQW    address of the requant {m0,n} word (DRAM == scratchpad)
; @param N      elements
; @param CHUNK  elements per pass (<= 1023, divides N)

.equ attn_rq_NCHUNK 256 // 256
.equ attn_rq_CH4    256 * 4

.reg attn_rq_src   r1
.reg attn_rq_dst   r2
.reg attn_rq_rqw   r3
.reg attn_rq_nch   r4
.reg attn_rq_one   r5
.reg attn_rq_ch4   r6
.reg attn_rq_ch1   r7
.reg attn_rq_i     r8
.reg attn_rq_so    r9
.reg attn_rq_do    r10

    li      attn_rq_src, 0x1180
    li      attn_rq_dst, 0x1580
    li      attn_rq_rqw, 0x208c
    setcfg  len, 4
    rdmem   attn_rq_rqw, attn_rq_rqw              ; stage {m0,n} (identical DRAM/scratch addr)

    setcfg  vlen, 256
    li      attn_rq_nch, attn_rq_NCHUNK
    li      attn_rq_one, 1
    li      attn_rq_ch4, attn_rq_CH4
    li      attn_rq_ch1, 256
    li      attn_rq_i, 0
attn_rq_loop:
    cmps    attn_rq_i, attn_rq_nch
    bge     attn_rq_done
    muls    attn_rq_so, attn_rq_i, attn_rq_ch4
    adds    attn_rq_so, attn_rq_so, attn_rq_src          ; &src[i*CHUNK]  (int32 stride)
    muls    attn_rq_do, attn_rq_i, attn_rq_ch1
    adds    attn_rq_do, attn_rq_do, attn_rq_dst          ; &dst[i*CHUNK]  (int8 stride)
    setcfg  len, attn_rq_CH4
    rdmem   attn_rq_so, attn_rq_so
    requant attn_rq_do, attn_rq_so, attn_rq_rqw
    setcfg  len, 256
    wrmem   attn_rq_do, attn_rq_do
    adds    attn_rq_i, attn_rq_i, attn_rq_one
    jmp     attn_rq_loop
attn_rq_done:

; --------------------------------------------------------------------------
; [8] matmul_ternary  (proj)  — [8,32] @ [32,32] ternary -> int8
; --------------------------------------------------------------------------
; @primitive matmul_ternary
; @clobbers r1-r30, cfg tlen/len/scalar
;
; C[M,N] int8 = requant(A[M,K] int8 @ W[K,N] ternary)   — the MXU workhorse.
;
; examples/tiled_matmul.tpu generalized: three nested tile loops (M, N, K) over
; an 8x8 array, with only the current tiles resident, so A, W and C may each be
; far larger than the scratchpad. The K flavours are the whole trick —
;
;     kt = 0        matmul          initialise the int32 partial
;     kt = 1..K-2   matmul.acc      C += this tile
;     kt = K-1      matmul.acc.rq   C += last tile, then requant int32 -> int8
;
; so the full contraction accumulates in int32 and exactly one requant happens,
; at the end. (KTILES >= 2 is therefore required: there must be a distinct init
; tile and a distinct requant tile. primitives.py asserts it.)
;
; **Layout: A and C are plain row-major [M,K] / [M,N].** The MXU wants an
; activation tile as T rows of ROWS *contiguous* bytes, which a row-major matrix
; is not, so the A tile is gathered one row at a time (T DMA fills of ROWS bytes
; at DRAM stride K) and the C tile is scattered back the same way. That costs two
; short loops and buys the thing that matters for composition: every activation
; in the generated program is plain row-major, so the VPU primitives — which have
; no notion of tiles — can consume any matmul's output directly.
;
; W is the exception: it is a *weight*, packed offline by quant.pack_ternary into
; the tile-major [nt][kt] order this loop walks, 2 bits per trit, column-major
; within a tile. It is read with one contiguous DMA per tile.
;
; Scratchpad footprint is fixed at T*8 + 16 + T*8*4 bytes regardless of M, K, N.
;
; @param A     DRAM byte address of A[M,K], int8, row-major
; @param W     DRAM byte address of W[K,N], ternary, tile-major [nt][kt] packed
; @param C     DRAM byte address of C[M,N], int8, row-major (output)
; @param RQW   address of the requant {m0,n} word (int32; DRAM == scratchpad)
; @param M     rows of A / C          (multiple of TT)
; @param K     contraction length     (multiple of 8, KTILES >= 2)
; @param N     columns of W / C       (multiple of 8)
; @param ABUF  scratchpad buffer for one A tile      (TT*8 bytes)
; @param WBUF  scratchpad buffer for one W tile      (16 bytes)
; @param CBUF  scratchpad int32 accumulator          (TT*8*4 bytes)
; @default TT  8

; ---- array / problem geometry ------------------------------------------------
.equ proj_ROWS   8                          ; MXU contraction dim (K per tile)
.equ proj_COLS   8                          ; MXU output features (N per tile)
.equ proj_T      8                     ; tokens per matmul pass (cfg tlen)
.equ proj_MTILES 8 // 8
.equ proj_KTILES 32 // proj_ROWS
.equ proj_NTILES 32 // proj_COLS
.equ proj_WTILE  proj_COLS * ((proj_ROWS * 2) // 8) ; packed ternary bytes per tile (= 16)

.reg proj_abuf   r1
.reg proj_wbuf   r2
.reg proj_cbuf   r3
.reg proj_rqw    r4
.reg proj_abase  r5
.reg proj_wbase  r6
.reg proj_cbase  r7
.reg proj_mt     r8
.reg proj_nt     r9
.reg proj_kt     r10
.reg proj_mtiles r11
.reg proj_ntiles r12
.reg proj_ktiles r13
.reg proj_klast  r14
.reg proj_one    r15
.reg proj_eight  r16
.reg proj_tt     r17            ; row counter for the gather / scatter loops
.reg proj_trows  r18            ; T
.reg proj_kdim   r19            ; K  (row stride of A)
.reg proj_ndim   r20            ; N  (row stride of C)
.reg proj_wtile  r21
.reg proj_arow   r22            ; A + mt*T*K      — top-left of this M block
.reg proj_crow   r23            ; C + mt*T*N
.reg proj_wcol   r24            ; W + nt*KTILES*WTILE
.reg proj_ctil   r25            ; crow + nt*COLS  — top-left of this C tile
.reg proj_at     r26            ; arow + kt*ROWS  — top-left of this A tile
.reg proj_wt     r27
.reg proj_s      r28            ; scratch/DRAM source cursor
.reg proj_d      r29            ; scratch/DRAM destination cursor

    setcfg  tlen,   proj_T
    setcfg  scalar, 0x2090     ; MXU reads {m0,n} from this scratchpad address

    li  proj_abuf,   0x53d8
    li  proj_wbuf,   0x5418
    li  proj_cbuf,   0x5428
    li  proj_rqw,    0x2090
    li  proj_abase,  0x1580
    li  proj_wbase,  0x0400
    li  proj_cbase,  0x1680
    li  proj_mtiles, proj_MTILES
    li  proj_ntiles, proj_NTILES
    li  proj_ktiles, proj_KTILES
    li  proj_klast,  proj_KTILES - 1
    li  proj_one,    1
    li  proj_eight,  proj_ROWS
    li  proj_trows,  proj_T
    li  proj_kdim,   32
    li  proj_ndim,   32
    li  proj_wtile,  proj_WTILE

    ; ---- stage the requant word once (identical DRAM/scratchpad address) ----
    setcfg  len, 4
    rdmem   proj_rqw, proj_rqw

    li  proj_mt, 0
proj_mloop:
    cmps    proj_mt, proj_mtiles
    bge     proj_mdone
    muls    proj_arow, proj_mt, proj_trows
    muls    proj_arow, proj_arow, proj_kdim
    adds    proj_arow, proj_arow, proj_abase        ; arow = A + mt*T*K
    muls    proj_crow, proj_mt, proj_trows
    muls    proj_crow, proj_crow, proj_ndim
    adds    proj_crow, proj_crow, proj_cbase        ; crow = C + mt*T*N
    li      proj_nt, 0

proj_nloop:
    cmps    proj_nt, proj_ntiles
    bge     proj_ndone
    muls    proj_wcol, proj_nt, proj_ktiles
    muls    proj_wcol, proj_wcol, proj_wtile
    adds    proj_wcol, proj_wcol, proj_wbase        ; wcol = W + nt*KTILES*WTILE
    muls    proj_ctil, proj_nt, proj_eight
    adds    proj_ctil, proj_ctil, proj_crow         ; ctil = crow + nt*COLS
    li      proj_kt, 0

proj_kloop:
    ; ---- gather one A tile: T rows of ROWS bytes, DRAM row stride K ----
    muls    proj_at, proj_kt, proj_eight
    adds    proj_at, proj_at, proj_arow
    setcfg  len, proj_ROWS
    li      proj_tt, 0
proj_aloop:
    cmps    proj_tt, proj_trows
    bge     proj_adone
    muls    proj_s, proj_tt, proj_kdim
    adds    proj_s, proj_s, proj_at                 ; DRAM    A + (mt*T+tt)*K + kt*ROWS
    muls    proj_d, proj_tt, proj_eight
    adds    proj_d, proj_d, proj_abuf               ; scratch ABUF + tt*ROWS
    rdmem   proj_d, proj_s
    adds    proj_tt, proj_tt, proj_one
    jmp     proj_aloop
proj_adone:

    ; ---- one W tile: contiguous, already in the layout the MXU wants ----
    muls    proj_wt, proj_kt, proj_wtile
    adds    proj_wt, proj_wt, proj_wcol
    setcfg  len, proj_WTILE
    rdmem   proj_wbuf, proj_wt

    ; ---- the matmul flavour depends on where this tile sits in K ----
    cmps    proj_kt, r0
    bne     proj_knotfirst
    matmul  proj_cbuf, proj_abuf, proj_wbuf             ; kt = 0: initialise the accumulator
    jmp     proj_knext
proj_knotfirst:
    cmps    proj_kt, proj_klast
    bne     proj_kmiddle
    matmul.acc.rq  proj_cbuf, proj_abuf, proj_wbuf      ; kt = K-1: accumulate, then requant
    jmp     proj_knext
proj_kmiddle:
    matmul.acc     proj_cbuf, proj_abuf, proj_wbuf      ; middle: accumulate in int32
proj_knext:
    adds    proj_kt, proj_kt, proj_one
    cmps    proj_kt, proj_ktiles
    blt     proj_kloop

    ; ---- scatter the T x COLS int8 tile back into row-major C ----
    ; The .rq store wrote int8 at cbuf + t*COLS, overlaying the accumulator's
    ; low bytes, so the scratch row stride here is COLS, not COLS*4.
    setcfg  len, proj_COLS
    li      proj_tt, 0
proj_cloop:
    cmps    proj_tt, proj_trows
    bge     proj_cdone
    muls    proj_s, proj_tt, proj_eight
    adds    proj_s, proj_s, proj_cbuf               ; scratch CBUF + tt*COLS
    muls    proj_d, proj_tt, proj_ndim
    adds    proj_d, proj_d, proj_ctil               ; DRAM    C + (mt*T+tt)*N + nt*COLS
    wrmem   proj_s, proj_d
    adds    proj_tt, proj_tt, proj_one
    jmp     proj_cloop
proj_cdone:

    adds    proj_nt, proj_nt, proj_one
    jmp     proj_nloop
proj_ndone:
    adds    proj_mt, proj_mt, proj_one
    jmp     proj_mloop
proj_mdone:

; --------------------------------------------------------------------------
; [9] add_i8  (res1)  — residual
; --------------------------------------------------------------------------
; @primitive add_i8
; @clobbers r1-r13, cfg vlen/len
;
; C[N] int8 = requant(A[N] int8 + B[N] int8)
;
; `vecadd` widens int8 + int8 -> int32 (that widening is the point — a residual
; sum overflows int8 routinely), so the requant back to int8 is not decoration,
; it is what makes the result consumable by the next VPU op. With A and B in the
; same scale the {m0,n} word is the identity {1,0} and the requant is a plain
; int8 clip.
;
; Two jobs in the transformer layer, and they are the same op:
;   * the two **residual adds**;
;   * the **causal attention mask** — a mask is an int8 tensor of 0 and -128, and
;     adding -128 drives an entry to the clip floor, which in the exp table's
;     1/16 input scale is x = -8, where the table stores 0. So masking is data,
;     not an instruction.
;
; @param A      DRAM address of A[N], int8
; @param B      DRAM address of B[N], int8
; @param C      DRAM address of C[N], int8 (output; may alias A or B)
; @param RQW    address of the requant {m0,n} word (DRAM == scratchpad)
; @param TMP    scratchpad int32 buffer, CHUNK*4 bytes
; @param N      elements
; @param CHUNK  elements per pass (<= 1023, divides N)

.equ res1_NCHUNK 256 // 256

.reg res1_a     r1
.reg res1_b     r2
.reg res1_c     r3
.reg res1_rqw   r4
.reg res1_tmp   r5
.reg res1_nch   r6
.reg res1_one   r7
.reg res1_ch    r8
.reg res1_i     r9
.reg res1_off   r10
.reg res1_ao    r11
.reg res1_bo    r12
.reg res1_co    r13

    li      res1_a,   0x0000
    li      res1_b,   0x1680
    li      res1_c,   0x1780
    li      res1_rqw, 0x2094
    setcfg  len, 4
    rdmem   res1_rqw, res1_rqw

    li      res1_tmp, 0x5528
    setcfg  vlen, 256
    li      res1_nch, res1_NCHUNK
    li      res1_one, 1
    li      res1_ch,  256
    li      res1_i, 0
res1_loop:
    cmps    res1_i, res1_nch
    bge     res1_done
    muls    res1_off, res1_i, res1_ch
    adds    res1_ao, res1_off, res1_a
    adds    res1_bo, res1_off, res1_b
    adds    res1_co, res1_off, res1_c
    setcfg  len, 256
    rdmem   res1_ao, res1_ao
    rdmem   res1_bo, res1_bo
    vecadd  res1_tmp, res1_ao, res1_bo         ; int8 + int8 -> int32
    requant res1_co, res1_tmp, res1_rqw        ; int32 -> int8
    wrmem   res1_co, res1_co
    adds    res1_i, res1_i, res1_one
    jmp     res1_loop
res1_done:

; --------------------------------------------------------------------------
; [10] layernorm_rows  (norm1)  — 8 rows of 32
; --------------------------------------------------------------------------
; @primitive layernorm_rows
; @clobbers r1-r28, cfg vlen/len
;
; Y[R,L] int8 = gamma * (x - mean) / sqrt(var) + beta, per row.
;
; --------------------------------------------------------------------------
; The interesting part: **the scalar unit has no shift and no divide.**
; --------------------------------------------------------------------------
; `adds`, `subs`, `muls` and `cmps` are the whole scalar ALU (isa.md §A.4), so
; neither the restoring-sqrt bit walk (which needs `bit >>= 1`) nor a Newton
; iteration (which needs a divide) can be written directly. The way through is
; that **the scratchpad is the shifter**: build the powers of two 1, 2, ... 2^15
; by repeated doubling, `stores` them ascending, then `loads` them back
; descending with a pointer that walks down by 4. Writing the sequence to memory
; and reading it backwards *is* the right shift the ISA does not have.
;
; That one table then drives both scalar loops, which are the same shape:
;
;     q = 0
;     for b in 2^15, 2^14, ... 1:     ; ...read back descending
;         t = q + b
;         if f(t) <= v: q = t          ; f = t*L for divide, t*t for sqrt
;
; giving exactly floor(v/L) and floor(sqrt(v)) in ~12 instructions each.
;
; --------------------------------------------------------------------------
; The vector pipeline, and why it is shaped this way
; --------------------------------------------------------------------------
;     redsum  S    <- row                    S = sum x_i
;     mu = trunc(S / L)                      scalar idiv loop (above)
;     sadd    t32  <- row, -mu               int32: x_i - mu
;     requant c8   <- t32   {1,0}            int8 (clips at +-127)
;     vecdot  SS   <- c8, c8                 SS = sum (x_i - mu)^2, int32
;     R = floor(sqrt(SS))                    scalar isqrt loop (above)
;     sdiv    t32  <- c8, R                  int32 Q15: round(c8 * 2^15 / R)
;     requant t8   <- t32   {m0,n} = RQY     int8 at the output scale
;     vecemul t32  <- t8, gamma              int8 * int8 -> int32
;     requant t8   <- t32   {m0,n} = RQG     int8
;     vecadd  t32  <- t8, beta               int8 + int8 -> int32
;     requant Y    <- t32   {1,0}            int8
;
; `vecdot(c8, c8)` rather than `square` + `redsum` is not a stylistic choice:
; `square` writes int32 and `redsum` reads int8, so the obvious spelling is
; exactly the type error that makes examples/softmax_row.tpu unrunnable.
; `vecdot` does both halves in one op and never leaves int32.
;
; Nothing at run time ever divides by L or by sqrt(L): dividing by L happens once
; in the scalar loop, and the leftover sqrt(L) from normalizing by
; R = sqrt(sum c^2) instead of by sqrt(sum c^2 / L) is a compile-time constant
; folded into RQY's m0 by quant.layernorm_requant.
;
; Precision, stated plainly: c8 is int8, so a row entry more than 127 quantization
; steps from its mean is clipped. That is a property of an int8 LayerNorm, not a
; bug — the integer reference clips identically, so exactness still holds.
;
; @param SRC    DRAM address of X[R,L], int8, row-major
; @param DST    DRAM address of Y[R,L], int8, row-major
; @param GAMMA  DRAM address of gamma[L], int8
; @param BETA   DRAM address of beta[L], int8
; @param R      rows
; @param L      row length (= cfg vlen)
; @param RQY    address of the {m0,n} word applied after the normalize
; @param RQG    address of the {m0,n} word applied after the gamma multiply
; @param RQ1    scratchpad int32 word: holds {m0=1, n=0}, built below
; @param TBL    scratchpad buffer, 64 bytes: the powers-of-two table
; @param C8     scratchpad int8  buffer, L bytes: the centred row
; @param T8     scratchpad int8  buffer, L bytes: shared int8 temporary
; @param T32    scratchpad int32 buffer, L*4 bytes: shared int32 temporary
; @param W0     scratchpad int32 word: the row sum, then the sum of squares
; @param NEGM   scratchpad int32 word: -mean, as a broadcast scalar
; @param RVAL   scratchpad int32 word: R = floor(sqrt(sum c^2))

.equ norm1_BYTES  8 * 32
.equ norm1_NBITS  16                             ; table entries: 2^0 .. 2^15
.equ norm1_TBLTOP 0x592c + 4 * (norm1_NBITS - 1)

.reg norm1_src    r1
.reg norm1_dst    r2
.reg norm1_gamma  r3
.reg norm1_beta   r4
.reg norm1_c8     r5
.reg norm1_t8     r6
.reg norm1_t32    r7
.reg norm1_w0     r8
.reg norm1_negm   r9
.reg norm1_rval   r10
.reg norm1_rq1    r11
.reg norm1_rqy    r12
.reg norm1_rqg    r13
.reg norm1_tbl    r14
.reg norm1_rows   r15
.reg norm1_ll     r16                            ; L — also the divisor in the idiv loop
.reg norm1_one    r17
.reg norm1_four   r18
.reg norm1_r      r19
.reg norm1_rowsrc r20
.reg norm1_rowdst r21
.reg norm1_v      r22                            ; scalar work value
.reg norm1_sgn    r23
.reg norm1_q      r24                            ; scalar loop accumulator
.reg norm1_tp     r25                            ; table cursor
.reg norm1_bb     r26                            ; the current power of two
.reg norm1_tt     r27
.reg norm1_uu     r28

    li      norm1_one,  1
    li      norm1_four, 4
    li      norm1_rq1,  0x5928
    stores  norm1_rq1, norm1_one                      ; {m0 = 1, n = 0}

    ; ---- build the powers-of-two table: 1, 2, 4, ... 2^15 ----
    li      norm1_tbl, 0x592c
    li      norm1_v,   1
    li      norm1_tp,  0x592c
    li      norm1_q,   0
    li      norm1_bb,  norm1_NBITS
norm1_tloop:
    cmps    norm1_q, norm1_bb
    bge     norm1_tdone
    stores  norm1_tp, norm1_v
    adds    norm1_v,  norm1_v, norm1_v                     ; the only "shift" the ISA has
    adds    norm1_tp, norm1_tp, norm1_four
    adds    norm1_q,  norm1_q, norm1_one
    jmp     norm1_tloop
norm1_tdone:

    ; ---- stage operands: DRAM -> scratchpad (identical addresses) ----
    li      norm1_src,   0x1780
    li      norm1_dst,   0x1880
    li      norm1_gamma, 0x0900
    li      norm1_beta,  0x0920
    li      norm1_rqy,   0x2098
    li      norm1_rqg,   0x209c
    setcfg  len, 4
    rdmem   norm1_rqy, norm1_rqy
    rdmem   norm1_rqg, norm1_rqg
    setcfg  len, 32
    rdmem   norm1_gamma, norm1_gamma
    rdmem   norm1_beta,  norm1_beta
    setcfg  len, norm1_BYTES
    rdmem   norm1_src, norm1_src

    li      norm1_c8,   0x596c
    li      norm1_t8,   0x598c
    li      norm1_t32,  0x59ac
    li      norm1_w0,   0x5a2c
    li      norm1_negm, 0x5a30
    li      norm1_rval, 0x5a34
    li      norm1_rows, 8
    li      norm1_ll,   32

    setcfg  vlen, 32                     ; every vector op below walks one row
    li      norm1_r, 0
norm1_rloop:
    cmps    norm1_r, norm1_rows
    bge     norm1_rdone
    muls    norm1_rowsrc, norm1_r, norm1_ll
    adds    norm1_rowsrc, norm1_rowsrc, norm1_src
    muls    norm1_rowdst, norm1_r, norm1_ll
    adds    norm1_rowdst, norm1_rowdst, norm1_dst

    ; ---- mean: mu = trunc(S / L), by binary long division ----
    redsum  norm1_w0, norm1_rowsrc
    loads   norm1_v, norm1_w0
    li      norm1_sgn, 0
    cmps    norm1_v, r0
    bge     norm1_vpos
    subs    norm1_v, r0, norm1_v                      ; work with |S|, re-sign at the end
    li      norm1_sgn, 1
norm1_vpos:
    li      norm1_q,  0
    li      norm1_tp, norm1_TBLTOP
norm1_dloop:
    cmps    norm1_tp, norm1_tbl
    blt     norm1_ddone
    loads   norm1_bb, norm1_tp                        ; ...the next power of two, descending
    adds    norm1_tt, norm1_q, norm1_bb
    muls    norm1_uu, norm1_tt, norm1_ll
    cmps    norm1_v, norm1_uu
    blt     norm1_dskip                          ; t*L > |S| -> this bit stays clear
    adds    norm1_q, norm1_tt, r0
norm1_dskip:
    subs    norm1_tp, norm1_tp, norm1_four
    jmp     norm1_dloop
norm1_ddone:
    cmps    norm1_sgn, r0
    beq     norm1_mpos
    subs    norm1_q, r0, norm1_q
norm1_mpos:
    subs    norm1_v, r0, norm1_q
    stores  norm1_negm, norm1_v                       ; -mu, broadcastable

    ; ---- centre, and narrow so the VPU can read it back ----
    sadd    norm1_t32, norm1_rowsrc, norm1_negm            ; x_i - mu   (int32)
    requant norm1_c8, norm1_t32, norm1_rq1                 ; int8

    ; ---- R = floor(sqrt(sum c^2)), same loop with f(t) = t*t ----
    vecdot  norm1_w0, norm1_c8, norm1_c8
    loads   norm1_v, norm1_w0
    li      norm1_q,  0
    li      norm1_tp, norm1_TBLTOP
norm1_sloop:
    cmps    norm1_tp, norm1_tbl
    blt     norm1_sdone
    loads   norm1_bb, norm1_tp
    adds    norm1_tt, norm1_q, norm1_bb
    muls    norm1_uu, norm1_tt, norm1_tt
    cmps    norm1_v, norm1_uu
    blt     norm1_sskip
    adds    norm1_q, norm1_tt, r0
norm1_sskip:
    subs    norm1_tp, norm1_tp, norm1_four
    jmp     norm1_sloop
norm1_sdone:
    cmps    norm1_q, r0
    bne     norm1_rnz
    li      norm1_q, 1                           ; a constant row: divide by 1, not 0
norm1_rnz:
    stores  norm1_rval, norm1_q

    ; ---- normalize, scale, shift ----
    sdiv    norm1_t32, norm1_c8, norm1_rval                ; Q15
    requant norm1_t8,  norm1_t32, norm1_rqy                ; int8 at the output scale
    vecemul norm1_t32, norm1_t8, norm1_gamma
    requant norm1_t8,  norm1_t32, norm1_rqg
    vecadd  norm1_t32, norm1_t8, norm1_beta
    requant norm1_rowdst, norm1_t32, norm1_rq1

    adds    norm1_r, norm1_r, norm1_one
    jmp     norm1_rloop
norm1_rdone:
    setcfg  len, norm1_BYTES
    wrmem   norm1_dst, norm1_dst

; --------------------------------------------------------------------------
; [11] matmul_ternary  (ff1)  — [8,32] @ [32,64] ternary -> int8
; --------------------------------------------------------------------------
; @primitive matmul_ternary
; @clobbers r1-r30, cfg tlen/len/scalar
;
; C[M,N] int8 = requant(A[M,K] int8 @ W[K,N] ternary)   — the MXU workhorse.
;
; examples/tiled_matmul.tpu generalized: three nested tile loops (M, N, K) over
; an 8x8 array, with only the current tiles resident, so A, W and C may each be
; far larger than the scratchpad. The K flavours are the whole trick —
;
;     kt = 0        matmul          initialise the int32 partial
;     kt = 1..K-2   matmul.acc      C += this tile
;     kt = K-1      matmul.acc.rq   C += last tile, then requant int32 -> int8
;
; so the full contraction accumulates in int32 and exactly one requant happens,
; at the end. (KTILES >= 2 is therefore required: there must be a distinct init
; tile and a distinct requant tile. primitives.py asserts it.)
;
; **Layout: A and C are plain row-major [M,K] / [M,N].** The MXU wants an
; activation tile as T rows of ROWS *contiguous* bytes, which a row-major matrix
; is not, so the A tile is gathered one row at a time (T DMA fills of ROWS bytes
; at DRAM stride K) and the C tile is scattered back the same way. That costs two
; short loops and buys the thing that matters for composition: every activation
; in the generated program is plain row-major, so the VPU primitives — which have
; no notion of tiles — can consume any matmul's output directly.
;
; W is the exception: it is a *weight*, packed offline by quant.pack_ternary into
; the tile-major [nt][kt] order this loop walks, 2 bits per trit, column-major
; within a tile. It is read with one contiguous DMA per tile.
;
; Scratchpad footprint is fixed at T*8 + 16 + T*8*4 bytes regardless of M, K, N.
;
; @param A     DRAM byte address of A[M,K], int8, row-major
; @param W     DRAM byte address of W[K,N], ternary, tile-major [nt][kt] packed
; @param C     DRAM byte address of C[M,N], int8, row-major (output)
; @param RQW   address of the requant {m0,n} word (int32; DRAM == scratchpad)
; @param M     rows of A / C          (multiple of TT)
; @param K     contraction length     (multiple of 8, KTILES >= 2)
; @param N     columns of W / C       (multiple of 8)
; @param ABUF  scratchpad buffer for one A tile      (TT*8 bytes)
; @param WBUF  scratchpad buffer for one W tile      (16 bytes)
; @param CBUF  scratchpad int32 accumulator          (TT*8*4 bytes)
; @default TT  8

; ---- array / problem geometry ------------------------------------------------
.equ ff1_ROWS   8                          ; MXU contraction dim (K per tile)
.equ ff1_COLS   8                          ; MXU output features (N per tile)
.equ ff1_T      8                     ; tokens per matmul pass (cfg tlen)
.equ ff1_MTILES 8 // 8
.equ ff1_KTILES 32 // ff1_ROWS
.equ ff1_NTILES 64 // ff1_COLS
.equ ff1_WTILE  ff1_COLS * ((ff1_ROWS * 2) // 8) ; packed ternary bytes per tile (= 16)

.reg ff1_abuf   r1
.reg ff1_wbuf   r2
.reg ff1_cbuf   r3
.reg ff1_rqw    r4
.reg ff1_abase  r5
.reg ff1_wbase  r6
.reg ff1_cbase  r7
.reg ff1_mt     r8
.reg ff1_nt     r9
.reg ff1_kt     r10
.reg ff1_mtiles r11
.reg ff1_ntiles r12
.reg ff1_ktiles r13
.reg ff1_klast  r14
.reg ff1_one    r15
.reg ff1_eight  r16
.reg ff1_tt     r17            ; row counter for the gather / scatter loops
.reg ff1_trows  r18            ; T
.reg ff1_kdim   r19            ; K  (row stride of A)
.reg ff1_ndim   r20            ; N  (row stride of C)
.reg ff1_wtile  r21
.reg ff1_arow   r22            ; A + mt*T*K      — top-left of this M block
.reg ff1_crow   r23            ; C + mt*T*N
.reg ff1_wcol   r24            ; W + nt*KTILES*WTILE
.reg ff1_ctil   r25            ; crow + nt*COLS  — top-left of this C tile
.reg ff1_at     r26            ; arow + kt*ROWS  — top-left of this A tile
.reg ff1_wt     r27
.reg ff1_s      r28            ; scratch/DRAM source cursor
.reg ff1_d      r29            ; scratch/DRAM destination cursor

    setcfg  tlen,   ff1_T
    setcfg  scalar, 0x20a0     ; MXU reads {m0,n} from this scratchpad address

    li  ff1_abuf,   0x5a38
    li  ff1_wbuf,   0x5a78
    li  ff1_cbuf,   0x5a88
    li  ff1_rqw,    0x20a0
    li  ff1_abase,  0x1880
    li  ff1_wbase,  0x0500
    li  ff1_cbase,  0x1980
    li  ff1_mtiles, ff1_MTILES
    li  ff1_ntiles, ff1_NTILES
    li  ff1_ktiles, ff1_KTILES
    li  ff1_klast,  ff1_KTILES - 1
    li  ff1_one,    1
    li  ff1_eight,  ff1_ROWS
    li  ff1_trows,  ff1_T
    li  ff1_kdim,   32
    li  ff1_ndim,   64
    li  ff1_wtile,  ff1_WTILE

    ; ---- stage the requant word once (identical DRAM/scratchpad address) ----
    setcfg  len, 4
    rdmem   ff1_rqw, ff1_rqw

    li  ff1_mt, 0
ff1_mloop:
    cmps    ff1_mt, ff1_mtiles
    bge     ff1_mdone
    muls    ff1_arow, ff1_mt, ff1_trows
    muls    ff1_arow, ff1_arow, ff1_kdim
    adds    ff1_arow, ff1_arow, ff1_abase        ; arow = A + mt*T*K
    muls    ff1_crow, ff1_mt, ff1_trows
    muls    ff1_crow, ff1_crow, ff1_ndim
    adds    ff1_crow, ff1_crow, ff1_cbase        ; crow = C + mt*T*N
    li      ff1_nt, 0

ff1_nloop:
    cmps    ff1_nt, ff1_ntiles
    bge     ff1_ndone
    muls    ff1_wcol, ff1_nt, ff1_ktiles
    muls    ff1_wcol, ff1_wcol, ff1_wtile
    adds    ff1_wcol, ff1_wcol, ff1_wbase        ; wcol = W + nt*KTILES*WTILE
    muls    ff1_ctil, ff1_nt, ff1_eight
    adds    ff1_ctil, ff1_ctil, ff1_crow         ; ctil = crow + nt*COLS
    li      ff1_kt, 0

ff1_kloop:
    ; ---- gather one A tile: T rows of ROWS bytes, DRAM row stride K ----
    muls    ff1_at, ff1_kt, ff1_eight
    adds    ff1_at, ff1_at, ff1_arow
    setcfg  len, ff1_ROWS
    li      ff1_tt, 0
ff1_aloop:
    cmps    ff1_tt, ff1_trows
    bge     ff1_adone
    muls    ff1_s, ff1_tt, ff1_kdim
    adds    ff1_s, ff1_s, ff1_at                 ; DRAM    A + (mt*T+tt)*K + kt*ROWS
    muls    ff1_d, ff1_tt, ff1_eight
    adds    ff1_d, ff1_d, ff1_abuf               ; scratch ABUF + tt*ROWS
    rdmem   ff1_d, ff1_s
    adds    ff1_tt, ff1_tt, ff1_one
    jmp     ff1_aloop
ff1_adone:

    ; ---- one W tile: contiguous, already in the layout the MXU wants ----
    muls    ff1_wt, ff1_kt, ff1_wtile
    adds    ff1_wt, ff1_wt, ff1_wcol
    setcfg  len, ff1_WTILE
    rdmem   ff1_wbuf, ff1_wt

    ; ---- the matmul flavour depends on where this tile sits in K ----
    cmps    ff1_kt, r0
    bne     ff1_knotfirst
    matmul  ff1_cbuf, ff1_abuf, ff1_wbuf             ; kt = 0: initialise the accumulator
    jmp     ff1_knext
ff1_knotfirst:
    cmps    ff1_kt, ff1_klast
    bne     ff1_kmiddle
    matmul.acc.rq  ff1_cbuf, ff1_abuf, ff1_wbuf      ; kt = K-1: accumulate, then requant
    jmp     ff1_knext
ff1_kmiddle:
    matmul.acc     ff1_cbuf, ff1_abuf, ff1_wbuf      ; middle: accumulate in int32
ff1_knext:
    adds    ff1_kt, ff1_kt, ff1_one
    cmps    ff1_kt, ff1_ktiles
    blt     ff1_kloop

    ; ---- scatter the T x COLS int8 tile back into row-major C ----
    ; The .rq store wrote int8 at cbuf + t*COLS, overlaying the accumulator's
    ; low bytes, so the scratch row stride here is COLS, not COLS*4.
    setcfg  len, ff1_COLS
    li      ff1_tt, 0
ff1_cloop:
    cmps    ff1_tt, ff1_trows
    bge     ff1_cdone
    muls    ff1_s, ff1_tt, ff1_eight
    adds    ff1_s, ff1_s, ff1_cbuf               ; scratch CBUF + tt*COLS
    muls    ff1_d, ff1_tt, ff1_ndim
    adds    ff1_d, ff1_d, ff1_ctil               ; DRAM    C + (mt*T+tt)*N + nt*COLS
    wrmem   ff1_s, ff1_d
    adds    ff1_tt, ff1_tt, ff1_one
    jmp     ff1_cloop
ff1_cdone:

    adds    ff1_nt, ff1_nt, ff1_one
    jmp     ff1_nloop
ff1_ndone:
    adds    ff1_mt, ff1_mt, ff1_one
    jmp     ff1_mloop
ff1_mdone:

; --------------------------------------------------------------------------
; [12] gelu_block  (gelu)  — 512 elements, LUT in_scale 1/16
; --------------------------------------------------------------------------
; @primitive gelu_block
; @clobbers r1-r11, cfg vlen/len
;
; dst[N] int8 = requant(gelu_lut[src[N] int8])
;
; **The input must already be in the LUT's 1/16 input scale.** `gelu` is a
; 256-entry int8 ROM indexed by the raw operand byte (vpu.sv), so the table *is*
; the numerics and the input scale is assumed, never checked — feed it something
; else and it quietly evaluates gelu of the wrong number (luts.py).
;
; This primitive therefore does *not* rescale on the way in. Instead the composer
; makes the producing matmul's requant land its output directly in 1/16, which
; costs nothing: that requant had to happen anyway. On the way out, the table is
; scale-preserving (in_scale == out_scale == 1/16, and saturation is unreachable
; since |gelu(x)| <= |x|), so the exit requant only has to reach the consumer's
; scale.
;
; @param SRC    DRAM address of src[N], int8, **at scale 1/16**
; @param DST    DRAM address of dst[N], int8
; @param RQW    address of the exit requant {m0,n} word (DRAM == scratchpad)
; @param TMP    scratchpad int32 buffer, CHUNK*4 bytes
; @param N      elements
; @param CHUNK  elements per pass (<= 1023, divides N)

.equ gelu_NCHUNK 512 // 512

.reg gelu_src   r1
.reg gelu_dst   r2
.reg gelu_rqw   r3
.reg gelu_tmp   r4
.reg gelu_nch   r5
.reg gelu_one   r6
.reg gelu_ch    r7
.reg gelu_i     r8
.reg gelu_off   r9
.reg gelu_so    r10
.reg gelu_do    r11

    li      gelu_src, 0x1980
    li      gelu_dst, 0x1b80
    li      gelu_rqw, 0x20a4
    setcfg  len, 4
    rdmem   gelu_rqw, gelu_rqw

    li      gelu_tmp, 0x5b88
    setcfg  vlen, 512
    li      gelu_nch, gelu_NCHUNK
    li      gelu_one, 1
    li      gelu_ch,  512
    li      gelu_i, 0
gelu_loop:
    cmps    gelu_i, gelu_nch
    bge     gelu_done
    muls    gelu_off, gelu_i, gelu_ch
    adds    gelu_so, gelu_off, gelu_src
    adds    gelu_do, gelu_off, gelu_dst
    setcfg  len, 512
    rdmem   gelu_so, gelu_so
    gelu    gelu_tmp, gelu_so              ; int8 index -> int32 table value
    requant gelu_do, gelu_tmp, gelu_rqw
    wrmem   gelu_do, gelu_do
    adds    gelu_i, gelu_i, gelu_one
    jmp     gelu_loop
gelu_done:

; --------------------------------------------------------------------------
; [13] matmul_ternary  (ff2)  — [8,64] @ [64,32] ternary -> int8
; --------------------------------------------------------------------------
; @primitive matmul_ternary
; @clobbers r1-r30, cfg tlen/len/scalar
;
; C[M,N] int8 = requant(A[M,K] int8 @ W[K,N] ternary)   — the MXU workhorse.
;
; examples/tiled_matmul.tpu generalized: three nested tile loops (M, N, K) over
; an 8x8 array, with only the current tiles resident, so A, W and C may each be
; far larger than the scratchpad. The K flavours are the whole trick —
;
;     kt = 0        matmul          initialise the int32 partial
;     kt = 1..K-2   matmul.acc      C += this tile
;     kt = K-1      matmul.acc.rq   C += last tile, then requant int32 -> int8
;
; so the full contraction accumulates in int32 and exactly one requant happens,
; at the end. (KTILES >= 2 is therefore required: there must be a distinct init
; tile and a distinct requant tile. primitives.py asserts it.)
;
; **Layout: A and C are plain row-major [M,K] / [M,N].** The MXU wants an
; activation tile as T rows of ROWS *contiguous* bytes, which a row-major matrix
; is not, so the A tile is gathered one row at a time (T DMA fills of ROWS bytes
; at DRAM stride K) and the C tile is scattered back the same way. That costs two
; short loops and buys the thing that matters for composition: every activation
; in the generated program is plain row-major, so the VPU primitives — which have
; no notion of tiles — can consume any matmul's output directly.
;
; W is the exception: it is a *weight*, packed offline by quant.pack_ternary into
; the tile-major [nt][kt] order this loop walks, 2 bits per trit, column-major
; within a tile. It is read with one contiguous DMA per tile.
;
; Scratchpad footprint is fixed at T*8 + 16 + T*8*4 bytes regardless of M, K, N.
;
; @param A     DRAM byte address of A[M,K], int8, row-major
; @param W     DRAM byte address of W[K,N], ternary, tile-major [nt][kt] packed
; @param C     DRAM byte address of C[M,N], int8, row-major (output)
; @param RQW   address of the requant {m0,n} word (int32; DRAM == scratchpad)
; @param M     rows of A / C          (multiple of TT)
; @param K     contraction length     (multiple of 8, KTILES >= 2)
; @param N     columns of W / C       (multiple of 8)
; @param ABUF  scratchpad buffer for one A tile      (TT*8 bytes)
; @param WBUF  scratchpad buffer for one W tile      (16 bytes)
; @param CBUF  scratchpad int32 accumulator          (TT*8*4 bytes)
; @default TT  8

; ---- array / problem geometry ------------------------------------------------
.equ ff2_ROWS   8                          ; MXU contraction dim (K per tile)
.equ ff2_COLS   8                          ; MXU output features (N per tile)
.equ ff2_T      8                     ; tokens per matmul pass (cfg tlen)
.equ ff2_MTILES 8 // 8
.equ ff2_KTILES 64 // ff2_ROWS
.equ ff2_NTILES 32 // ff2_COLS
.equ ff2_WTILE  ff2_COLS * ((ff2_ROWS * 2) // 8) ; packed ternary bytes per tile (= 16)

.reg ff2_abuf   r1
.reg ff2_wbuf   r2
.reg ff2_cbuf   r3
.reg ff2_rqw    r4
.reg ff2_abase  r5
.reg ff2_wbase  r6
.reg ff2_cbase  r7
.reg ff2_mt     r8
.reg ff2_nt     r9
.reg ff2_kt     r10
.reg ff2_mtiles r11
.reg ff2_ntiles r12
.reg ff2_ktiles r13
.reg ff2_klast  r14
.reg ff2_one    r15
.reg ff2_eight  r16
.reg ff2_tt     r17            ; row counter for the gather / scatter loops
.reg ff2_trows  r18            ; T
.reg ff2_kdim   r19            ; K  (row stride of A)
.reg ff2_ndim   r20            ; N  (row stride of C)
.reg ff2_wtile  r21
.reg ff2_arow   r22            ; A + mt*T*K      — top-left of this M block
.reg ff2_crow   r23            ; C + mt*T*N
.reg ff2_wcol   r24            ; W + nt*KTILES*WTILE
.reg ff2_ctil   r25            ; crow + nt*COLS  — top-left of this C tile
.reg ff2_at     r26            ; arow + kt*ROWS  — top-left of this A tile
.reg ff2_wt     r27
.reg ff2_s      r28            ; scratch/DRAM source cursor
.reg ff2_d      r29            ; scratch/DRAM destination cursor

    setcfg  tlen,   ff2_T
    setcfg  scalar, 0x20a8     ; MXU reads {m0,n} from this scratchpad address

    li  ff2_abuf,   0x6388
    li  ff2_wbuf,   0x63c8
    li  ff2_cbuf,   0x63d8
    li  ff2_rqw,    0x20a8
    li  ff2_abase,  0x1b80
    li  ff2_wbase,  0x0700
    li  ff2_cbase,  0x1d80
    li  ff2_mtiles, ff2_MTILES
    li  ff2_ntiles, ff2_NTILES
    li  ff2_ktiles, ff2_KTILES
    li  ff2_klast,  ff2_KTILES - 1
    li  ff2_one,    1
    li  ff2_eight,  ff2_ROWS
    li  ff2_trows,  ff2_T
    li  ff2_kdim,   64
    li  ff2_ndim,   32
    li  ff2_wtile,  ff2_WTILE

    ; ---- stage the requant word once (identical DRAM/scratchpad address) ----
    setcfg  len, 4
    rdmem   ff2_rqw, ff2_rqw

    li  ff2_mt, 0
ff2_mloop:
    cmps    ff2_mt, ff2_mtiles
    bge     ff2_mdone
    muls    ff2_arow, ff2_mt, ff2_trows
    muls    ff2_arow, ff2_arow, ff2_kdim
    adds    ff2_arow, ff2_arow, ff2_abase        ; arow = A + mt*T*K
    muls    ff2_crow, ff2_mt, ff2_trows
    muls    ff2_crow, ff2_crow, ff2_ndim
    adds    ff2_crow, ff2_crow, ff2_cbase        ; crow = C + mt*T*N
    li      ff2_nt, 0

ff2_nloop:
    cmps    ff2_nt, ff2_ntiles
    bge     ff2_ndone
    muls    ff2_wcol, ff2_nt, ff2_ktiles
    muls    ff2_wcol, ff2_wcol, ff2_wtile
    adds    ff2_wcol, ff2_wcol, ff2_wbase        ; wcol = W + nt*KTILES*WTILE
    muls    ff2_ctil, ff2_nt, ff2_eight
    adds    ff2_ctil, ff2_ctil, ff2_crow         ; ctil = crow + nt*COLS
    li      ff2_kt, 0

ff2_kloop:
    ; ---- gather one A tile: T rows of ROWS bytes, DRAM row stride K ----
    muls    ff2_at, ff2_kt, ff2_eight
    adds    ff2_at, ff2_at, ff2_arow
    setcfg  len, ff2_ROWS
    li      ff2_tt, 0
ff2_aloop:
    cmps    ff2_tt, ff2_trows
    bge     ff2_adone
    muls    ff2_s, ff2_tt, ff2_kdim
    adds    ff2_s, ff2_s, ff2_at                 ; DRAM    A + (mt*T+tt)*K + kt*ROWS
    muls    ff2_d, ff2_tt, ff2_eight
    adds    ff2_d, ff2_d, ff2_abuf               ; scratch ABUF + tt*ROWS
    rdmem   ff2_d, ff2_s
    adds    ff2_tt, ff2_tt, ff2_one
    jmp     ff2_aloop
ff2_adone:

    ; ---- one W tile: contiguous, already in the layout the MXU wants ----
    muls    ff2_wt, ff2_kt, ff2_wtile
    adds    ff2_wt, ff2_wt, ff2_wcol
    setcfg  len, ff2_WTILE
    rdmem   ff2_wbuf, ff2_wt

    ; ---- the matmul flavour depends on where this tile sits in K ----
    cmps    ff2_kt, r0
    bne     ff2_knotfirst
    matmul  ff2_cbuf, ff2_abuf, ff2_wbuf             ; kt = 0: initialise the accumulator
    jmp     ff2_knext
ff2_knotfirst:
    cmps    ff2_kt, ff2_klast
    bne     ff2_kmiddle
    matmul.acc.rq  ff2_cbuf, ff2_abuf, ff2_wbuf      ; kt = K-1: accumulate, then requant
    jmp     ff2_knext
ff2_kmiddle:
    matmul.acc     ff2_cbuf, ff2_abuf, ff2_wbuf      ; middle: accumulate in int32
ff2_knext:
    adds    ff2_kt, ff2_kt, ff2_one
    cmps    ff2_kt, ff2_ktiles
    blt     ff2_kloop

    ; ---- scatter the T x COLS int8 tile back into row-major C ----
    ; The .rq store wrote int8 at cbuf + t*COLS, overlaying the accumulator's
    ; low bytes, so the scratch row stride here is COLS, not COLS*4.
    setcfg  len, ff2_COLS
    li      ff2_tt, 0
ff2_cloop:
    cmps    ff2_tt, ff2_trows
    bge     ff2_cdone
    muls    ff2_s, ff2_tt, ff2_eight
    adds    ff2_s, ff2_s, ff2_cbuf               ; scratch CBUF + tt*COLS
    muls    ff2_d, ff2_tt, ff2_ndim
    adds    ff2_d, ff2_d, ff2_ctil               ; DRAM    C + (mt*T+tt)*N + nt*COLS
    wrmem   ff2_s, ff2_d
    adds    ff2_tt, ff2_tt, ff2_one
    jmp     ff2_cloop
ff2_cdone:

    adds    ff2_nt, ff2_nt, ff2_one
    jmp     ff2_nloop
ff2_ndone:
    adds    ff2_mt, ff2_mt, ff2_one
    jmp     ff2_mloop
ff2_mdone:

; --------------------------------------------------------------------------
; [14] add_i8  (res2)  — residual
; --------------------------------------------------------------------------
; @primitive add_i8
; @clobbers r1-r13, cfg vlen/len
;
; C[N] int8 = requant(A[N] int8 + B[N] int8)
;
; `vecadd` widens int8 + int8 -> int32 (that widening is the point — a residual
; sum overflows int8 routinely), so the requant back to int8 is not decoration,
; it is what makes the result consumable by the next VPU op. With A and B in the
; same scale the {m0,n} word is the identity {1,0} and the requant is a plain
; int8 clip.
;
; Two jobs in the transformer layer, and they are the same op:
;   * the two **residual adds**;
;   * the **causal attention mask** — a mask is an int8 tensor of 0 and -128, and
;     adding -128 drives an entry to the clip floor, which in the exp table's
;     1/16 input scale is x = -8, where the table stores 0. So masking is data,
;     not an instruction.
;
; @param A      DRAM address of A[N], int8
; @param B      DRAM address of B[N], int8
; @param C      DRAM address of C[N], int8 (output; may alias A or B)
; @param RQW    address of the requant {m0,n} word (DRAM == scratchpad)
; @param TMP    scratchpad int32 buffer, CHUNK*4 bytes
; @param N      elements
; @param CHUNK  elements per pass (<= 1023, divides N)

.equ res2_NCHUNK 256 // 256

.reg res2_a     r1
.reg res2_b     r2
.reg res2_c     r3
.reg res2_rqw   r4
.reg res2_tmp   r5
.reg res2_nch   r6
.reg res2_one   r7
.reg res2_ch    r8
.reg res2_i     r9
.reg res2_off   r10
.reg res2_ao    r11
.reg res2_bo    r12
.reg res2_co    r13

    li      res2_a,   0x1880
    li      res2_b,   0x1d80
    li      res2_c,   0x1e80
    li      res2_rqw, 0x20ac
    setcfg  len, 4
    rdmem   res2_rqw, res2_rqw

    li      res2_tmp, 0x64d8
    setcfg  vlen, 256
    li      res2_nch, res2_NCHUNK
    li      res2_one, 1
    li      res2_ch,  256
    li      res2_i, 0
res2_loop:
    cmps    res2_i, res2_nch
    bge     res2_done
    muls    res2_off, res2_i, res2_ch
    adds    res2_ao, res2_off, res2_a
    adds    res2_bo, res2_off, res2_b
    adds    res2_co, res2_off, res2_c
    setcfg  len, 256
    rdmem   res2_ao, res2_ao
    rdmem   res2_bo, res2_bo
    vecadd  res2_tmp, res2_ao, res2_bo         ; int8 + int8 -> int32
    requant res2_co, res2_tmp, res2_rqw        ; int32 -> int8
    wrmem   res2_co, res2_co
    adds    res2_i, res2_i, res2_one
    jmp     res2_loop
res2_done:

; --------------------------------------------------------------------------
; [15] layernorm_rows  (norm2)  — 8 rows of 32
; --------------------------------------------------------------------------
; @primitive layernorm_rows
; @clobbers r1-r28, cfg vlen/len
;
; Y[R,L] int8 = gamma * (x - mean) / sqrt(var) + beta, per row.
;
; --------------------------------------------------------------------------
; The interesting part: **the scalar unit has no shift and no divide.**
; --------------------------------------------------------------------------
; `adds`, `subs`, `muls` and `cmps` are the whole scalar ALU (isa.md §A.4), so
; neither the restoring-sqrt bit walk (which needs `bit >>= 1`) nor a Newton
; iteration (which needs a divide) can be written directly. The way through is
; that **the scratchpad is the shifter**: build the powers of two 1, 2, ... 2^15
; by repeated doubling, `stores` them ascending, then `loads` them back
; descending with a pointer that walks down by 4. Writing the sequence to memory
; and reading it backwards *is* the right shift the ISA does not have.
;
; That one table then drives both scalar loops, which are the same shape:
;
;     q = 0
;     for b in 2^15, 2^14, ... 1:     ; ...read back descending
;         t = q + b
;         if f(t) <= v: q = t          ; f = t*L for divide, t*t for sqrt
;
; giving exactly floor(v/L) and floor(sqrt(v)) in ~12 instructions each.
;
; --------------------------------------------------------------------------
; The vector pipeline, and why it is shaped this way
; --------------------------------------------------------------------------
;     redsum  S    <- row                    S = sum x_i
;     mu = trunc(S / L)                      scalar idiv loop (above)
;     sadd    t32  <- row, -mu               int32: x_i - mu
;     requant c8   <- t32   {1,0}            int8 (clips at +-127)
;     vecdot  SS   <- c8, c8                 SS = sum (x_i - mu)^2, int32
;     R = floor(sqrt(SS))                    scalar isqrt loop (above)
;     sdiv    t32  <- c8, R                  int32 Q15: round(c8 * 2^15 / R)
;     requant t8   <- t32   {m0,n} = RQY     int8 at the output scale
;     vecemul t32  <- t8, gamma              int8 * int8 -> int32
;     requant t8   <- t32   {m0,n} = RQG     int8
;     vecadd  t32  <- t8, beta               int8 + int8 -> int32
;     requant Y    <- t32   {1,0}            int8
;
; `vecdot(c8, c8)` rather than `square` + `redsum` is not a stylistic choice:
; `square` writes int32 and `redsum` reads int8, so the obvious spelling is
; exactly the type error that makes examples/softmax_row.tpu unrunnable.
; `vecdot` does both halves in one op and never leaves int32.
;
; Nothing at run time ever divides by L or by sqrt(L): dividing by L happens once
; in the scalar loop, and the leftover sqrt(L) from normalizing by
; R = sqrt(sum c^2) instead of by sqrt(sum c^2 / L) is a compile-time constant
; folded into RQY's m0 by quant.layernorm_requant.
;
; Precision, stated plainly: c8 is int8, so a row entry more than 127 quantization
; steps from its mean is clipped. That is a property of an int8 LayerNorm, not a
; bug — the integer reference clips identically, so exactness still holds.
;
; @param SRC    DRAM address of X[R,L], int8, row-major
; @param DST    DRAM address of Y[R,L], int8, row-major
; @param GAMMA  DRAM address of gamma[L], int8
; @param BETA   DRAM address of beta[L], int8
; @param R      rows
; @param L      row length (= cfg vlen)
; @param RQY    address of the {m0,n} word applied after the normalize
; @param RQG    address of the {m0,n} word applied after the gamma multiply
; @param RQ1    scratchpad int32 word: holds {m0=1, n=0}, built below
; @param TBL    scratchpad buffer, 64 bytes: the powers-of-two table
; @param C8     scratchpad int8  buffer, L bytes: the centred row
; @param T8     scratchpad int8  buffer, L bytes: shared int8 temporary
; @param T32    scratchpad int32 buffer, L*4 bytes: shared int32 temporary
; @param W0     scratchpad int32 word: the row sum, then the sum of squares
; @param NEGM   scratchpad int32 word: -mean, as a broadcast scalar
; @param RVAL   scratchpad int32 word: R = floor(sqrt(sum c^2))

.equ norm2_BYTES  8 * 32
.equ norm2_NBITS  16                             ; table entries: 2^0 .. 2^15
.equ norm2_TBLTOP 0x68dc + 4 * (norm2_NBITS - 1)

.reg norm2_src    r1
.reg norm2_dst    r2
.reg norm2_gamma  r3
.reg norm2_beta   r4
.reg norm2_c8     r5
.reg norm2_t8     r6
.reg norm2_t32    r7
.reg norm2_w0     r8
.reg norm2_negm   r9
.reg norm2_rval   r10
.reg norm2_rq1    r11
.reg norm2_rqy    r12
.reg norm2_rqg    r13
.reg norm2_tbl    r14
.reg norm2_rows   r15
.reg norm2_ll     r16                            ; L — also the divisor in the idiv loop
.reg norm2_one    r17
.reg norm2_four   r18
.reg norm2_r      r19
.reg norm2_rowsrc r20
.reg norm2_rowdst r21
.reg norm2_v      r22                            ; scalar work value
.reg norm2_sgn    r23
.reg norm2_q      r24                            ; scalar loop accumulator
.reg norm2_tp     r25                            ; table cursor
.reg norm2_bb     r26                            ; the current power of two
.reg norm2_tt     r27
.reg norm2_uu     r28

    li      norm2_one,  1
    li      norm2_four, 4
    li      norm2_rq1,  0x68d8
    stores  norm2_rq1, norm2_one                      ; {m0 = 1, n = 0}

    ; ---- build the powers-of-two table: 1, 2, 4, ... 2^15 ----
    li      norm2_tbl, 0x68dc
    li      norm2_v,   1
    li      norm2_tp,  0x68dc
    li      norm2_q,   0
    li      norm2_bb,  norm2_NBITS
norm2_tloop:
    cmps    norm2_q, norm2_bb
    bge     norm2_tdone
    stores  norm2_tp, norm2_v
    adds    norm2_v,  norm2_v, norm2_v                     ; the only "shift" the ISA has
    adds    norm2_tp, norm2_tp, norm2_four
    adds    norm2_q,  norm2_q, norm2_one
    jmp     norm2_tloop
norm2_tdone:

    ; ---- stage operands: DRAM -> scratchpad (identical addresses) ----
    li      norm2_src,   0x1e80
    li      norm2_dst,   0x1f80
    li      norm2_gamma, 0x0940
    li      norm2_beta,  0x0960
    li      norm2_rqy,   0x20b0
    li      norm2_rqg,   0x20b4
    setcfg  len, 4
    rdmem   norm2_rqy, norm2_rqy
    rdmem   norm2_rqg, norm2_rqg
    setcfg  len, 32
    rdmem   norm2_gamma, norm2_gamma
    rdmem   norm2_beta,  norm2_beta
    setcfg  len, norm2_BYTES
    rdmem   norm2_src, norm2_src

    li      norm2_c8,   0x691c
    li      norm2_t8,   0x693c
    li      norm2_t32,  0x695c
    li      norm2_w0,   0x69dc
    li      norm2_negm, 0x69e0
    li      norm2_rval, 0x69e4
    li      norm2_rows, 8
    li      norm2_ll,   32

    setcfg  vlen, 32                     ; every vector op below walks one row
    li      norm2_r, 0
norm2_rloop:
    cmps    norm2_r, norm2_rows
    bge     norm2_rdone
    muls    norm2_rowsrc, norm2_r, norm2_ll
    adds    norm2_rowsrc, norm2_rowsrc, norm2_src
    muls    norm2_rowdst, norm2_r, norm2_ll
    adds    norm2_rowdst, norm2_rowdst, norm2_dst

    ; ---- mean: mu = trunc(S / L), by binary long division ----
    redsum  norm2_w0, norm2_rowsrc
    loads   norm2_v, norm2_w0
    li      norm2_sgn, 0
    cmps    norm2_v, r0
    bge     norm2_vpos
    subs    norm2_v, r0, norm2_v                      ; work with |S|, re-sign at the end
    li      norm2_sgn, 1
norm2_vpos:
    li      norm2_q,  0
    li      norm2_tp, norm2_TBLTOP
norm2_dloop:
    cmps    norm2_tp, norm2_tbl
    blt     norm2_ddone
    loads   norm2_bb, norm2_tp                        ; ...the next power of two, descending
    adds    norm2_tt, norm2_q, norm2_bb
    muls    norm2_uu, norm2_tt, norm2_ll
    cmps    norm2_v, norm2_uu
    blt     norm2_dskip                          ; t*L > |S| -> this bit stays clear
    adds    norm2_q, norm2_tt, r0
norm2_dskip:
    subs    norm2_tp, norm2_tp, norm2_four
    jmp     norm2_dloop
norm2_ddone:
    cmps    norm2_sgn, r0
    beq     norm2_mpos
    subs    norm2_q, r0, norm2_q
norm2_mpos:
    subs    norm2_v, r0, norm2_q
    stores  norm2_negm, norm2_v                       ; -mu, broadcastable

    ; ---- centre, and narrow so the VPU can read it back ----
    sadd    norm2_t32, norm2_rowsrc, norm2_negm            ; x_i - mu   (int32)
    requant norm2_c8, norm2_t32, norm2_rq1                 ; int8

    ; ---- R = floor(sqrt(sum c^2)), same loop with f(t) = t*t ----
    vecdot  norm2_w0, norm2_c8, norm2_c8
    loads   norm2_v, norm2_w0
    li      norm2_q,  0
    li      norm2_tp, norm2_TBLTOP
norm2_sloop:
    cmps    norm2_tp, norm2_tbl
    blt     norm2_sdone
    loads   norm2_bb, norm2_tp
    adds    norm2_tt, norm2_q, norm2_bb
    muls    norm2_uu, norm2_tt, norm2_tt
    cmps    norm2_v, norm2_uu
    blt     norm2_sskip
    adds    norm2_q, norm2_tt, r0
norm2_sskip:
    subs    norm2_tp, norm2_tp, norm2_four
    jmp     norm2_sloop
norm2_sdone:
    cmps    norm2_q, r0
    bne     norm2_rnz
    li      norm2_q, 1                           ; a constant row: divide by 1, not 0
norm2_rnz:
    stores  norm2_rval, norm2_q

    ; ---- normalize, scale, shift ----
    sdiv    norm2_t32, norm2_c8, norm2_rval                ; Q15
    requant norm2_t8,  norm2_t32, norm2_rqy                ; int8 at the output scale
    vecemul norm2_t32, norm2_t8, norm2_gamma
    requant norm2_t8,  norm2_t32, norm2_rqg
    vecadd  norm2_t32, norm2_t8, norm2_beta
    requant norm2_rowdst, norm2_t32, norm2_rq1

    adds    norm2_r, norm2_r, norm2_one
    jmp     norm2_rloop
norm2_rdone:
    setcfg  len, norm2_BYTES
    wrmem   norm2_dst, norm2_dst

    halt
