; softmax_rows.tpu — softmax over a whole block of score rows, as ONE instruction.
;
; examples/softmax_row.tpu does a *single* row in 8 instructions, and needs a
; scalar bridge to do it: `redmax` writes its result to scratchpad, `loads`
; pulls it into a register, `subs` negates it, `stores` puts it back, and only
; then can `sadd` broadcast it. Wrapping that in a per-row loop is what makes
; attention expensive to hand-write.
;
; `softmax dst, src, tmp` runs the whole block (docs/macro_ops.md §5.1). The row
; max never leaves the VPU, so the loads/subs/stores bridge disappears entirely.
;
; It also fixes a real bug by construction. In softmax_row.tpu the chain is
;
;     sadd  shift, x, nega    ; writes int32 -- 4-byte elements
;     exp   expa,  shift      ; reads  int8  -- 1-byte elements
;
; which do not line up; the file's own header admits the missing `requant`. The
; macro op fuses subtract -> requant -> exp into one pass that writes **int8**,
; so the next pass's int8 read is correct by construction and there is no
; intermediate for a program to mis-declare.
;
; TMP LAYOUT. Each tmp row needs vlen + 4 bytes: vlen int8 exp values, then one
; int32 where the hardware parks that row's denominator between its internal
; passes. TROW below is sized accordingly, and getting it wrong would have row
; t+1's exp values overwrite row t's denominator.
;
;     python ../assembler.py softmax_rows.tpu --listing
;     python ../gen_vectors.py -p examples/softmax_rows.tpu
;
; Self-contained over DRAM (identical DRAM/scratchpad addresses) like the rest.

; ---- geometry ----------------------------------------------------------------
.equ ROWS   5           ; score rows (more than one: exercises the row advance)
.equ N      24          ; row length

; ---- strides (bytes) ---------------------------------------------------------
.equ SROW   N           ; source row stride: N int8        = 24
.equ TROW   N + 4       ; tmp row stride: N int8 + int32   = 28  <-- the +4
.equ DROW   N * 4       ; dst row stride: N int32          = 96

; ---- addresses (same in DRAM and scratchpad) ---------------------------------
.equ X      0x0000      ; X[ROWS][N] int8, the scores      (120 bytes)
.equ RQW    0x0400      ; requant {m0,n} into the exp scale (4 bytes)
.equ TMP    0x0800      ; scratch: exp values + denominator (140 bytes)
.equ P      0x1000      ; P[ROWS][N] int32, Q15            (480 bytes)

.equ X_BYTES    ROWS * SROW     ; 120
.equ RQW_BYTES  4
.equ P_BYTES    ROWS * DROW     ; 480

.reg x      r1
.reg rqw    r2
.reg tmp    r3
.reg p      r4

    li      x,   X
    li      rqw, RQW
    li      tmp, TMP
    li      p,   P

    ; ---- stage inputs --------------------------------------------------------
    setcfg  len, X_BYTES
    rdmem   x, x
    setcfg  len, RQW_BYTES
    rdmem   rqw, rqw

    ; ---- describe the block --------------------------------------------------
    setcfg  vlen,    N          ; elements per row
    setcfg  vrows,   ROWS       ; how many rows
    setcfg  vrow0,   SROW       ; source row stride
    setcfg  vrow1,   TROW       ; tmp row stride (N + 4)
    setcfg  vcrow,   DROW       ; destination row stride
    setcfg  vscalar, RQW        ; {m0,n} landing x-max in the exp table's scale

    softmax p, x, tmp           ; the whole block: max, exp, sum, normalize

    ; ---- spill ---------------------------------------------------------------
    setcfg  len, P_BYTES
    wrmem   p, p
    halt
